// =============================================================================
// Verris - Prisma Schema
// -----------------------------------------------------------------------------
// Foundation schema covering: IAM, hosting accounts (DirectAdmin/CloudLinux LVE),
// subscriptions (Stripe), wallet ledger, autoscaling pricing & events, telemetry,
// audit log, support and bootstrap of new compute nodes.
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  // native = dev machines; debian-openssl-3.0.x = node:22-bookworm-slim (prod Docker)
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// IAM
// -----------------------------------------------------------------------------

enum Role {
  USER
  STAFF
  ADMIN
}

enum CustomerPermission {
  BILLING_READ
  BILLING_MANAGE
  SERVICES_READ
  SERVICES_MANAGE
  DOMAINS_READ
  DOMAINS_MANAGE
  DNS_MANAGE
  EMAIL_MANAGE
  FILES_MANAGE
  TICKETS_READ
  TICKETS_MANAGE
  SETTINGS_MANAGE
}

/// RBAC-1 — rola/dział staffa. `permissions` to lista kluczy z katalogu
/// (StaffPermission, trzymana w kodzie, by dodawanie nowych nie wymagało migracji enum).
/// `isSystem` = wstępnie zasiane działy (edytowalne, nieusuwalne).
model StaffRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String[] @default([])
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     User[]
}

model User {
  id                       String    @id @default(uuid())
  email                    String    @unique
  passwordHash             String
  role                     Role      @default(USER)

  // RBAC-1 — dział/rola staffa (granularne uprawnienia panelu admina/staff).
  // Dotyczy tylko kont STAFF; ADMIN ma pełny dostęp niezależnie od roli.
  staffRoleId              String?
  staffRole                StaffRole? @relation(fields: [staffRoleId], references: [id], onDelete: SetNull)

  // Profile
  firstName                String?
  lastName                 String?
  companyName              String?
  nip                      String?
  address                  String?
  city                     String?
  postalCode               String?
  country                  String?   @default("PL")
  locale                   String    @default("pl")

  // C3 — bumped to invalidate every issued JWT for this user ("wyloguj
  // wszystkie urządzenia" / forced logout after password change/compromise).
  tokenVersion             Int       @default(0)

  // Wallet (Pay-As-You-Go) — derived from WalletTransaction ledger; kept as
  // a denormalized counter for fast reads, always updated transactionally
  // alongside ledger inserts.
  walletBalance            Decimal   @default(0.00) @db.Decimal(12, 2)
  walletCurrency           String    @default("PLN")

  // Loyalty (Etap G)
  ecoPoints                Int       @default(0)
  referralCode           String?   @unique
  referredByUserId       String?
  referredBy             User?     @relation("UserReferrals", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referredUsers          User[]    @relation("UserReferrals")
  // RESELL — program partnerski (afiliacja).
  partnerCommissions     PartnerCommission[] @relation("PartnerCommissions")
  referredCommissions    PartnerCommission[] @relation("ReferredCommissions")
  partnerPayouts         PartnerPayout[]     @relation("PartnerPayouts")
  /// Nieauthoryzowany token do publicznego badge SVG (`GET /public/eco/badge/:token`).
  ecoBadgeToken          String?   @unique
  /// Łączna liczba unikalnych wyświetleń badge (po deduplikacji IP/godzina).
  ecoBadgeImpressions    Int       @default(0)

  // 2FA — TOTP (RFC 6238). `twoFactorSecret` and `twoFactorRecoveryCodesEnc`
  // are encrypted at rest with the application KMS key (AES-256-GCM).
  twoFactorSecret          String?
  isTwoFactorEnabled       Boolean   @default(false)
  twoFactorEnrolledAt      DateTime?
  twoFactorRecoveryCodesEnc String?

  // SEC-6 — opcjonalny (opt-in) wymóg silnego logowania dla konta klienta.
  // Gdy true: logowanie samym hasłem jest niewystarczające — wymagane 2FA
  // (jeśli włączone) albo passkey. Włączane tylko gdy konto ma już czynnik.
  requireStrongAuth        Boolean   @default(false)

  // C2 — WebAuthn / passkeys. Transient challenge for registration/auth ceremony.
  webauthnChallenge        String?
  webauthnChallengeExpires DateTime?
  webauthnCredentials      WebAuthnCredential[]
  webauthnLoginChallenges  WebAuthnLoginChallenge[]
  // SEC-10 — aktywne sesje (lista urządzeń + zdalne wylogowanie pojedynczej sesji).
  sessions                 UserSession[]            @relation("UserSessions")
  // #11 — kredyty SLA przyznane użytkownikowi
  slaCredits               SlaCredit[]
  // Passkey enforcement for ADMIN/STAFF. Once a privileged user has logged in
  // with a passkey under enforcement we set `passkeyEnforcedAt`; afterwards the
  // password-only path is rejected (must use passkey or audited break-glass).
  passkeyEnforcedAt          DateTime?
  staffBreakGlassCodesEnc    String?
  staffBreakGlassGeneratedAt DateTime?
  staffBreakGlassUsedAt      DateTime?

  // Stripe
  stripeCustomerId         String?   @unique
  defaultPaymentMethodId   String?

  // Observability — staff with this flag get Editor access in Grafana via
  // Caddy `forward_auth`. ADMINs are always granted Admin role automatically;
  // this flag is only meaningful for STAFF.
  canAccessGrafana         Boolean   @default(false)

  // ---------------------------------------------------------------------------
  // RODO / GDPR — Sprint 1 (Legal/RODO)
  // ---------------------------------------------------------------------------
  /// Datestamp of the *most recent* terms acceptance — refreshed by re-consent.
  /// Null = legacy account from before we required explicit consent.
  termsAcceptedAt          DateTime?
  /// Datestamp of the *most recent* privacy policy acceptance.
  privacyAcceptedAt        DateTime?
  /// Semver of the terms version the user has accepted. Compared against the
  /// current published version to trigger re-consent flow on next request.
  lastConsentVersionTerms  String?
  /// Semver of the privacy policy version the user has accepted.
  lastConsentVersionPrivacy String?
  /// Timestamp the user requested account deletion (Art. 17). Anonymization
  /// happens 14 days later via `account-deletion.scheduler`. While set, the
  /// account is in read-only grace mode and shows a banner with cancel link.
  deletionRequestedAt      DateTime?
  /// Timestamp when PII was anonymized. After this, the row stays for
  /// invoicing audit (5y PL legal requirement) but contains no personal data.
  anonymizedAt             DateTime?
  /// Potwierdzenie adresu e-mail (link z rejestracji). Null = oczekuje na weryfikację.
  emailVerifiedAt          DateTime?
  /// SEC-9 — oczekujący nowy adres e-mail (self-service zmiana z weryfikacją).
  /// Ustawiany przy żądaniu zmiany; po potwierdzeniu linkiem staje się `email`.
  pendingEmail             String?
  /// O-1 — timestamp pierwszego uruchomienia darmowego okresu próbnego (jeden trial na konto).
  trialStartedAt           DateTime?

  // ---------------------------------------------------------------------------
  // Sprint 4 / R-04 — operacje admina na koncie klienta (tylko USER)
  // ---------------------------------------------------------------------------
  /// Gdy true — logowanie do panelu klienta jest zablokowane (hasło + 2FA).
  loginBlocked             Boolean   @default(false)
  /// Opcjonalny powód blokady (widoczny w audycie / dla operatorów).
  loginBlockedReason       String?   @db.Text
  /// Notatka wewnętrzna BOK (nie pokazywana klientowi).
  adminInternalNote        String?   @db.Text

  /// 4 skróty w sidebarze panelu klienta (href z katalogu `SIDEBAR_TILE_OPTIONS`).
  sidebarQuickLinks        String[]  @default([])

  // IAM / subaccounts — USER może mieć subkonta działające w kontekście ownera.
  customerOwnerId          String?
  customerOwner            User?     @relation("CustomerSubaccounts", fields: [customerOwnerId], references: [id], onDelete: Cascade)
  customerSubaccounts      User[]    @relation("CustomerSubaccounts")
  customerPermissions      CustomerPermission[] @default([])
  subaccountDisabledAt     DateTime?
  subaccountLabel          String?

  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  // Relations
  accounts                 Account[]
  subscriptions            Subscription[]
  walletTransactions       WalletTransaction[]
  paymentMethods           PaymentMethod[]
  invoices                 Invoice[]
  domains                  Domain[]
  vpsInstances             VpsInstance[]
  sshKeys                  SshKey[]
  purchasedAddons          PurchasedAddon[]
  // P-8 — priority support add-on (flag + expiry). Consumed by ticket SLA.
  prioritySupport          Boolean   @default(false)
  prioritySupportUntil     DateTime?
  domainRegistrarOrders    DomainRegistrarOrder[]
  aiInteractions           AiInteractionLog[]
  aiKnowledgeDocs          AiKnowledgeDoc[]    @relation("AiKnowledgeDocAuthor")
  tickets                  Ticket[]            @relation("ClientTickets")
  assignedTickets          Ticket[]            @relation("AssignedTickets")
  auditLogs                AuditLog[]          @relation("AuditUser")
  approvedServers          Server[]            @relation("ServerApprover")
  bootstrapTokensCreated   BootstrapToken[]    @relation("BootstrapTokenCreator")
  nodeTasksRequested       NodeTask[]          @relation("NodeTaskRequester")
  promoRedemptions         PromoRedemption[]
  walletAutoTopup          WalletAutoTopup?
  ticketAttachmentsUploaded TicketAttachment[] @relation("TicketAttachmentUploader")
  ecoPointsLedger           EcoPointsLedgerEntry[]
  ecoBadgeImpressionDedups  EcoBadgeImpressionDedup[]
  referralProgramEnrollment ReferralProgramEnrollment?
  referralEnrollmentsReviewed ReferralProgramEnrollment[] @relation("ReferralEnrollmentReviewer")
  platformSettingsUpdated   PlatformSetting[] @relation("PlatformSettingUpdatedBy")
  featureFlagsCreated       FeatureFlag[]      @relation("FeatureFlagCreator")
  featureFlagOverridesCreated FeatureFlagOverride[] @relation("FeatureFlagOverrideCreator")
  featureFlagOverrides       FeatureFlagOverride[] @relation("FeatureFlagUser")
  productAnnouncementsCreated ProductAnnouncement[] @relation("ProductAnnouncementCreator")
  ticketEscalations          Ticket[]          @relation("TicketEscalator")
  maintenanceWindowsCreated  MaintenanceWindow[] @relation("MaintenanceWindowCreator")
  statusWebhooksCreated      StatusWebhookEndpoint[] @relation("StatusWebhookCreator")
  customerInvitesSent        CustomerSubaccountInvite[] @relation("CustomerInviteSender")
  customerInvitesReceived    CustomerSubaccountInvite[] @relation("CustomerInviteReceiver")
  customerInviteAccepted     CustomerSubaccountInvite[] @relation("CustomerInviteAcceptedUser")

  // RODO relations (Sprint 1)
  consents                  UserConsent[]
  marketingPreferences      MarketingPreferences?
  dataExportRequests        DataExportRequest[]
  accountDeletionRequest    AccountDeletionRequest?
  publishedLegalDocs        LegalDocument[]   @relation("LegalDocPublisher")
  forcedDeletionRequests    AccountDeletionRequest[] @relation("AccountDeletionAdminAnonymizer")

  // Security (Sprint 2.5)
  loginEvents               LoginEvent[]

  // Auth tokens (password reset, future email verify)
  authTokens                UserAuthToken[]

  // MAIL-4 — skrzynka zespołu @verris.pl (SOGo + IMAP)
  controlPlaneMailbox       ControlPlaneMailbox?

  // Sprint 7 — pakietowe migracje
  migrationRequests         MigrationRequest[]

  // NTF-2 — powiadomienia in-app (dzwonek w panelu klienta)
  notifications             Notification[]
}

// NTF-2 — trwałe powiadomienia in-app (dzwonek panelu klienta).
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Kategoria: MONITORING, SSL, BILLING, SECURITY, SLA, SYSTEM.
  category  String
  // info | warning | critical
  severity  String   @default("info")
  title     String
  body      String   @db.Text
  // Opcjonalny link wewnątrz panelu (np. /dashboard/services/<id>).
  link      String?
  // Powiązana usługa (kontekst), opcjonalnie.
  subscriptionId String?

  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

enum UserAuthTokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
  EMAIL_CHANGE
}

model UserAuthToken {
  id        String               @id @default(uuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   UserAuthTokenPurpose
  tokenHash String               @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

/// SEC-10 — aktywna sesja użytkownika. `sid` (id) jest osadzony w JWT; strategia
/// odrzuca token, gdy sesja jest `revokedAt` lub nie istnieje. Pozwala wylogować
/// pojedyncze urządzenie bez zrywania wszystkich (to robi bump `tokenVersion`).
model UserSession {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)
  /// tokenVersion w chwili wydania — gdy user.tokenVersion się zmieni, sesja i tak wygasa.
  tokenVersion Int       @default(0)
  ipAddress    String?
  userAgent    String?
  deviceLabel  String?
  loginMethod  String?
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  revokedAt    DateTime?

  @@index([userId])
}

/// C2 — passkey (WebAuthn) credential. Stores only public material.
model WebAuthnCredential {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique
  publicKey    String    @db.Text
  counter      BigInt    @default(0)
  transports   String?
  deviceType   String?
  backedUp     Boolean   @default(false)
  name         String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

/// Krótkotrwały challenge logowania passkey (discoverable — bez wcześniejszego e-mail).
model WebAuthnLoginChallenge {
  id        String   @id @default(uuid())
  challenge String   @unique
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

enum CustomerSubaccountInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model CustomerSubaccountInvite {
  id              String                         @id @default(uuid())
  ownerUserId     String
  owner           User                           @relation("CustomerInviteSender", fields: [ownerUserId], references: [id], onDelete: Cascade)
  email           String
  tokenHash       String                         @unique
  permissions     CustomerPermission[]
  label           String?
  status          CustomerSubaccountInviteStatus @default(PENDING)
  acceptedUserId  String?
  acceptedUser    User?                          @relation("CustomerInviteAcceptedUser", fields: [acceptedUserId], references: [id], onDelete: SetNull)
  invitedByUserId String?
  invitedBy       User?                          @relation("CustomerInviteReceiver", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  @@index([ownerUserId, status])
  @@index([email])
}

// -----------------------------------------------------------------------------
// Etap G — księga punktów EKO (audyt przyznawania / redempcji)
// -----------------------------------------------------------------------------

model EcoPointsLedgerEntry {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta            Int
  reason           String   @db.VarChar(64)
  subscriptionId   String?
  /// Idempotencja: walletTxId, stripeInvoiceId, orderId itd.
  referenceId      String?  @db.VarChar(128)
  createdAt        DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, reason, referenceId])
}

/// Dedup wyświetleń badge EKO (max 1 zliczenie na IP użytkownika na godzinę).
model EcoBadgeImpressionDedup {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bucketKey String   @unique @db.VarChar(128)
  createdAt DateTime @default(now())

  @@index([userId])
}

// -----------------------------------------------------------------------------
// COMPUTE NODES (Servers)
// -----------------------------------------------------------------------------

enum ServerStatus {
  INIT             // Created in panel by admin, awaiting bootstrap handshake
  PENDING_APPROVAL // Handshake completed, awaiting admin approval
  ACTIVE           // Approved and ready to host new accounts
  MAINTENANCE      // Temporarily disabled for new account placement
  OFFLINE          // Not reachable / heartbeat missing
  DEPROVISIONING   // Being decommissioned, no new accounts
}

model Server {
  id              String       @id @default(uuid())
  name            String?
  hostname        String?
  ipAddress       String       @unique
  ipv6Address     String?      // public IPv6 of the node (for AAAA glue + zone records)
  region          String?      // e.g. "PL-WAW", "DE-FRA"
  status          ServerStatus @default(INIT)

  // Branded nameserver provisioning status (OVH glue + zone). Set by the
  // node-DNS automation so we don't re-create glue on every activation.
  nsProvisionedAt DateTime?

  // Capacity (reported via handshake / heartbeat)
  totalCpuCores   Int?
  totalMemoryMb   Int?
  totalDiskMb     Int?

  // Allocations from accounts on this server (sum of base limits)
  allocatedCpu    Int          @default(0)
  allocatedMemory Int          @default(0)
  allocatedDisk   Int          @default(0)

  // Capacity guardrails (admin-controlled placement policy) — NodeSelector
  // honours these so a node can be drained/capped WITHOUT going to MAINTENANCE
  // (which would pause sales platform-wide). See node-selector.service.ts.
  //  - acceptsNewAccounts: „cordon" — gdy false, węzeł nadal obsługuje
  //    istniejące konta (ACTIVE), ale scheduler nie umieszcza na nim nowych.
  //  - maxAccounts: twardy limit liczby kont na węźle (null = bez limitu).
  //  - reservedHeadroomPercent: % całkowitej pojemności CPU/RAM/dysku
  //    trzymany w rezerwie pod burst autoskalowania (0 = pakuj do pełna).
  acceptsNewAccounts      Boolean  @default(true)
  maxAccounts             Int?
  reservedHeadroomPercent Int      @default(0)

  // Identity / authentication of the node agent
  identityToken   String?      @unique
  publicKey       String?
  agentVersion    String?
  lastHandshakeAt DateTime?
  lastHeartbeatAt DateTime?

  // CloudLinux CageFS runtime status, reported by the verris-lve agent each
  // cycle (POST /telemetry/lve `node` block). Drives the node audit check.
  cagefsEnabled      Boolean?
  cagefsEnabledCount Int?
  cagefsCheckedAt    DateTime?

  // Audit F-07: security hardening status reported by the verris-lve agent
  // (presence of /etc/verris-hardened written by security-hardening-baseline.sh).
  hardenedEnabled    Boolean?
  hardenedCheckedAt  DateTime?

  // DB-1 — silnik i wersja bazy danych węzła (np. "MariaDB" / "10.6.18"),
  // raportowane przez agenta verris-lve (mariadbd --version). Pokazywane
  // klientowi w zakładce Bazy; port 3306 jest zamknięty z control-plane, więc
  // wersji nie da się odczytać bezpośrednio — bierzemy ją z telemetrii węzła.
  dbEngine           String?
  dbVersion          String?
  dbCheckedAt        DateTime?

  // VER-UPG — docelowa wersja silnika DB wybrana przez admina w edycji węzła
  // (np. "11.4"). Ustawiana przy zleceniu DB_UPGRADE; faktyczna wersja po
  // upgrade jest raportowana telemetrią agenta do dbVersion. Pokazywana w panelu
  // jako „upgrade w toku do X".
  targetDbVersion      String?
  dbUpgradeRequestedAt DateTime?

  // Incydent Hetzner 2026-06-11: detektor wychodzącego skanu na węźle zgłasza
  // alarm fan-outu; pokazywane w audycie węzła i alertach admina.
  lastSecurityAlertAt    DateTime?
  lastSecurityAlertKind  String?
  lastSecurityAlertInfo  String?

  // B-1 LIVE: off-node (offsite) backup agent reports last successful run so
  // the panel can flag stale/missing offsite backups (data-durability SLA).
  lastOffsiteBackupAt      DateTime?
  lastOffsiteBackupOk      Boolean   @default(false)
  lastOffsiteBackupInfo    String?

  // Authoritative nameservers handed to every account provisioned on this node
  // (DA `CMD_API_ACCOUNT_USER` ns1/ns2). Per-node override; when null the
  // platform default (PlatformSetting `hosting.ns*`, then env HOSTING_NS*) is
  // used. Start: point at OVH NS for the single node; later: ns1/ns2/ns3.verris.pl.
  ns1             String?
  ns2             String?
  ns3             String?

  // DirectAdmin config (encrypted at rest with the application KMS key)
  daHost          String?
  daPort          Int?
  daUsername      String?
  daPasswordEnc   String?      // AES-256-GCM (iv:tag:ciphertext, base64url)
  daUseTls        Boolean      @default(true)
  // Audit F-04: TLS certificate verification for the DA API connection is ON
  // by default. This per-node escape hatch exists ONLY for the onboarding
  // window before a proper cert lands on :2222 — the node audit flags it.
  daAllowInvalidCert Boolean   @default(false)

  // Acceptance flow
  approvedAt      DateTime?
  approvedById    String?
  approvedBy      User?        @relation("ServerApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  notes           String?

  // Sprint 4 / A-08 — maintenance mode metadata. Wpisywane gdy admin ręcznie
  // przełączy węzeł do MAINTENANCE; UI klienta i NodeSelector posługują się
  // tym powodem przy informacji o niedostępności kupna.
  maintenanceReason     String?
  maintenanceStartedAt  DateTime?
  maintenanceStartedById String?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  accounts        Account[]
  bootstrapTokens BootstrapToken[]
  probes          ServiceProbe[]
  maintenanceWindows MaintenanceWindow[]
  nodeTasks       NodeTask[]

  @@index([status])
}

enum NodeTaskKind {
  HOSTING_PROFILE
  WP_INSTALL        // A4 — instalator WordPress per konto klienta
  WAF_APPLY         // B2 — zastosowanie trybu ModSecurity WAF per konto
  STAGING_SYNC      // B5 — klon LIVE→staging lub publikacja staging→LIVE
  PHP_APPLY         // P-6 — zmiana wersji PHP konta (CloudLinux PHP Selector)
  APP_INSTALL       // P-3 — instalator 1-click aplikacji (Nextcloud/PrestaShop)
  DB_UPGRADE        // VER-UPG — upgrade silnika MariaDB węzła (CustomBuild) do wybranej wersji LTS
}

enum WafMode {
  OFF
  DETECTION   // SecRuleEngine DetectionOnly — loguje, nie blokuje
  ON          // SecRuleEngine On — blokuje
}

enum NodeTaskStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model NodeTask {
  id            String         @id @default(uuid())
  serverId      String
  server        Server         @relation(fields: [serverId], references: [id], onDelete: Cascade)
  kind          NodeTaskKind
  status        NodeTaskStatus @default(QUEUED)
  // A4 — per-account tasks (WP_INSTALL) carry the target account; server-wide
  // tasks (HOSTING_PROFILE) leave it null.
  accountId     String?
  payload       Json?
  outputLog     String?        @db.Text
  errorMessage  String?        @db.Text
  requestedById String?
  requestedBy   User?          @relation("NodeTaskRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([serverId, status])
  @@index([createdAt])
}

model BootstrapToken {
  id          String    @id @default(uuid())
  // SHA-256 of the plaintext token; the plaintext value is shown to the admin
  // exactly once when the token is generated and never persisted.
  tokenHash   String    @unique

  serverId    String
  server      Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)

  expiresAt   DateTime
  usedAt      DateTime?
  usedFromIp  String?
  revokedAt   DateTime?

  createdById String?
  createdBy   User?     @relation("BootstrapTokenCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())

  @@index([serverId])
  @@index([expiresAt])
}

// -----------------------------------------------------------------------------
// Status / maintenance calendar / webhooks (P-02/P-03 + V-16)
// -----------------------------------------------------------------------------

enum MaintenanceWindowStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

model MaintenanceWindow {
  id             String                  @id @default(uuid())
  serverId       String?
  server         Server?                 @relation(fields: [serverId], references: [id], onDelete: SetNull)
  title          String
  publicMessage  String?                 @db.Text
  internalNote   String?                 @db.Text
  status         MaintenanceWindowStatus @default(SCHEDULED)
  scheduledStart DateTime
  scheduledEnd   DateTime
  startedAt      DateTime?
  completedAt    DateTime?

  createdById    String?
  createdBy      User?                   @relation("MaintenanceWindowCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([status, scheduledStart])
  @@index([serverId])
}

enum StatusWebhookEvent {
  INCIDENT_CREATED
  INCIDENT_UPDATED
  INCIDENT_RESOLVED
  MAINTENANCE_SCHEDULED
  MAINTENANCE_UPDATED
}

model StatusWebhookEndpoint {
  id             String                  @id @default(uuid())
  url            String
  secretEnc      String?
  isActive       Boolean                 @default(true)
  events         StatusWebhookEvent[]
  createdById    String?
  createdBy      User?                   @relation("StatusWebhookCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  deliveries     StatusWebhookDelivery[]

  @@index([isActive])
}

enum StatusWebhookDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model StatusWebhookDelivery {
  id             String                        @id @default(uuid())
  endpointId     String
  endpoint       StatusWebhookEndpoint         @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event          StatusWebhookEvent
  payload        Json
  status         StatusWebhookDeliveryStatus   @default(PENDING)
  attempts       Int                           @default(0)
  responseStatus Int?
  lastError      String?                       @db.Text
  nextAttemptAt  DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
}

// -----------------------------------------------------------------------------
// PLANS, SUBSCRIPTIONS, ACCOUNTS
// -----------------------------------------------------------------------------

enum BillingInterval {
  MONTH
  YEAR
}

// P-1b — what kind of product a Plan represents. HOSTING = classic web hosting,
// EMAIL = standalone mailbox product (same DA-account machinery, mail-focused).
enum ProductKind {
  HOSTING
  EMAIL
}

model Plan {
  id                   String   @id @default(uuid())
  slug                 String   @unique
  name                 String
  description          String?

  // Base resource limits (CloudLinux LVE)
  cpuLimit             Int      // SPEED %
  ramLimitMb           Int
  diskLimitMb          Int
  ioLimitKbps          Int      @default(10240)
  iopsLimit            Int      @default(1024)
  entryProcesses       Int      @default(40)
  nprocLimit           Int      @default(20)

  // Included transfer (GB) per billing period
  includedTransferGb   Int?

  // Pricing
  priceMonthly         Decimal  @db.Decimal(10, 2)
  priceYearly          Decimal  @db.Decimal(10, 2)
  currency             String   @default("PLN")

  // Stripe references
  stripeProductId      String?
  stripePriceMonthlyId String?  @unique
  stripePriceYearlyId  String?  @unique

  isPublic             Boolean  @default(true)
  isActive             Boolean  @default(true)
  sortOrder            Int      @default(0)

  // O-1 — free trial length in days. 0 = no trial available for this plan.
  trialDays            Int      @default(0)

  // P-1b — product family this plan belongs to (hosting vs standalone e-mail).
  productKind          ProductKind @default(HOSTING)

  // SUP-5 — guaranteed support first-response time (hours). 0 = no SLA promise.
  supportSlaHours      Int      @default(0)

  // B6 — SSH/Git shell access for this plan (CageFS-jailed). Off by default;
  // higher tiers can enable it. Applied to the DA package `ssh` feature.
  sshAccess            Boolean  @default(false)

  // Max effective limit = base × ratio (e.g. 3 = up to 3× plan CPU/RAM/disk).
  autoscalingMaxOverscaleCpu   Float @default(3)
  autoscalingMaxOverscaleRam   Float @default(3)
  autoscalingMaxOverscaleDisk  Float @default(3)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  subscriptions        Subscription[]
  featureFlagPlanOverrides FeatureFlagPlanOverride[]

  @@index([isPublic, isActive])
}

enum SubscriptionStatus {
  PENDING_PAYMENT // Created, waiting for first payment
  PROVISIONING   // Payment OK, account being created on a node
  ACTIVE
  PAST_DUE       // Renewal failed, in grace period
  SUSPENDED      // Suspended due to non-payment
  CANCELED       // Customer canceled
  EXPIRED
}

enum SubscriptionPaymentSource {
  STRIPE_CARD
  WALLET
  MANUAL
}

model Subscription {
  id                   String                    @id @default(uuid())

  userId               String
  user                 User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId               String
  plan                 Plan                      @relation(fields: [planId], references: [id])

  status               SubscriptionStatus        @default(PENDING_PAYMENT)
  interval             BillingInterval

  // Pricing snapshot at sale time (immutable for this subscription instance)
  priceAmount          Decimal                   @db.Decimal(10, 2)
  /// List price before promo (null = same as priceAmount for legacy rows).
  listPriceAmount      Decimal?                  @db.Decimal(10, 2)
  currency             String                    @default("PLN")

  appliedPromoCodeId   String?
  appliedPromo         PromoCode?                @relation("SubscriptionAppliedPromo", fields: [appliedPromoCodeId], references: [id], onDelete: SetNull)

  // BILL-1 — rabat startowy z ustawień oferty (nie z kodu). % zniżki na
  // pierwsze N okresów; `introDiscountPeriodsLeft` dekrementowany przy każdym
  // naliczeniu — gdy 0, odnowienia idą pełną kwotą (lub wg kodu, jeśli był).
  introDiscountPct        Int    @default(0)
  introDiscountPeriodsLeft Int   @default(0)

  // Payment configuration
  paymentSource        SubscriptionPaymentSource @default(STRIPE_CARD)
  stripeSubscriptionId String?                   @unique

  // Lifecycle
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAt             DateTime?
  canceledAt           DateTime?
  trialEndsAt          DateTime?
  // O-1 — free trial bookkeeping.
  isTrial              Boolean                   @default(false)
  trialConvertedAt     DateTime?
  trialReminderSentAt  DateTime?

  // SVC-TAG — unikalny, krótki handle usługi (Cyberfolks-style, np. "wnbgswgc").
  // Widoczny obok pakietu dla klienta i admina/staff, ułatwia odnalezienie usługi.
  // Dla hostingu jest jednocześnie loginem DirectAdmin (realny prefiks baz danych).
  serviceTag           String?                   @unique

  // Provisioned account (1:1)
  account              Account?                  @relation("SubscriptionAccount")

  // B3 — opt-in site monitor (1:1)
  siteMonitor          SiteMonitor?

  // #11 — kredyty SLA przyznane tej subskrypcji
  slaCredits           SlaCredit[]

  // Autoscaling (per service)
  autoscalingEnabled   Boolean                   @default(false)
  autoscalingMaxCost   Decimal                   @default(0) @db.Decimal(10, 2)
  autoscalingDisabledReason String?
  // Per-resource toggles when autoscalingEnabled is true.
  autoscalingScaleCpu  Boolean                   @default(true)
  autoscalingScaleRam  Boolean                   @default(true)
  autoscalingScaleDisk Boolean                   @default(true)

  // Eco mode
  ecoModeEnabled       Boolean                   @default(false)

  // Sprint 5 / R-11+B-7 — szczegółowy status provisioningu widoczny dla klienta.
  // Wartości: queued, running, retrying, failed, completed.
  // Aktualizowany przez ProvisioningQueueService; pomocniczy względem `status`.
  provisioningStage    String?
  provisioningAttempts Int                       @default(0)
  provisioningLastError String?                  @db.Text
  provisioningStartedAt DateTime?
  provisioningCompletedAt DateTime?

  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  events               SubscriptionEvent[]
  autoscalingEvents    AutoscalingEvent[]
  usageMetrics         UsageMetric[]
  walletEntries        WalletTransaction[]       @relation("SubscriptionWalletEntries")
  invoices             Invoice[]
  migrationRequests    MigrationRequest[]
  healthSnapshots      ServiceHealthSnapshot[]
  domainChecklists     DomainChecklist[]
  hostingRestoreJobs   HostingRestoreJob[]
  backupSchedule       BackupSchedule?

  @@index([userId])
  @@index([status])
}

model SubscriptionEvent {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  type           String       // CREATED, ACTIVATED, RENEWED, PAYMENT_FAILED, SUSPENDED, ...
  details        Json?

  createdAt      DateTime     @default(now())

  @@index([subscriptionId])
}

// -----------------------------------------------------------------------------
// Sprint 7 — MigrationRequest (R-MIG-1+)
// -----------------------------------------------------------------------------
//
// Pakietowe zlecenie migracji ze starego hostingu: pliki (SFTP/rsync), bazy
// MySQL, skrzynki IMAP + opcjonalnie domena docelowa. Sekrety przechowujemy
// zaszyfrowane przez `CryptoService` (AES-256-GCM, klucz w `APP_KMS_KEY`).
// Status pcha kolejka workerów na compute-node (R-MIG-2+).

enum MigrationStatus {
  DRAFT
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

model MigrationRequest {
  id              String          @id @default(uuid())

  subscriptionId  String
  subscription    Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Zaszyfrowany JSON: { ftp?: {...}, mysql?: {...}, imap?: {...}, targetDomain?, notes? }
  sourceBundleEnc String          @db.Text
  /// Domena docelowa pod którą migrujemy. Może być `null` jeśli klient nie zna jeszcze.
  targetDomain    String?
  /// Etap, na którym jest zlecenie: queued/running/completed/failed/canceled
  status          MigrationStatus @default(QUEUED)
  /// Krótki kod aktualnego kroku (`files`, `mysql`, `imap`, `dns`, `done`).
  currentStep     String?
  /// Surowy log workerów (append-only, dla staff). Trim 256 KB.
  workerLog       String?         @db.Text
  /// Ostatni błąd, jeśli `status == FAILED`. Krótki, sanityzowany.
  lastError       String?         @db.Text
  /// `Ticket.id` powiązany ze zleceniem.
  ticketId        String?

  /// Audit-friendly liczniki wykonanych transferów.
  bytesTransferred BigInt         @default(0)
  filesTransferred Int            @default(0)
  databasesMigrated Int           @default(0)
  mailboxesMigrated Int           @default(0)

  startedAt       DateTime?
  completedAt     DateTime?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  workerJobs      MigrationWorkerJob[]

  @@index([subscriptionId])
  @@index([userId])
  @@index([status, createdAt])
}

enum MigrationWorkerJobKind {
  FILES_SFTP_RSYNC
  MYSQL_IMPORT
  IMAP_SYNC
  HTTP_POST_CHECK
}

enum MigrationWorkerJobStatus {
  QUEUED
  RUNNING
  RETRYING
  COMPLETED
  FAILED
  CANCELED
}

model MigrationWorkerJob {
  id                 String                   @id @default(uuid())
  migrationRequestId String
  migrationRequest   MigrationRequest         @relation(fields: [migrationRequestId], references: [id], onDelete: Cascade)

  kind               MigrationWorkerJobKind
  status             MigrationWorkerJobStatus @default(QUEUED)
  workerId           String?
  attempts           Int                      @default(0)
  maxAttempts        Int                      @default(3)
  idempotencyKey     String                   @unique
  payload            Json?
  lastError          String?                  @db.Text
  log                String?                  @db.Text

  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([migrationRequestId, status])
  @@index([status, createdAt])
}

enum AccountStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  DELETED
}

model Account {
  id              String        @id @default(uuid())

  // DirectAdmin
  daUsername      String        @unique
  daPasswordEnc   String?       // initial password / managed password (encrypted)
  domain          String        @unique // primary domain

  status          AccountStatus @default(PROVISIONING)

  // B2 — ModSecurity WAF mode for this account (applied via WAF_APPLY task).
  wafMode         WafMode       @default(DETECTION)
  wafAppliedAt    DateTime?

  // P-6 — per-account PHP version (CloudLinux PHP Selector), applied by the
  // node agent via a PHP_APPLY task. Null = node/account default.
  phpVersion      String?
  phpAppliedAt    DateTime?

  // B5 — staging (`staging.<domain>`): created/last-cloned timestamps,
  // confirmed by the STAGING_SYNC node task on completion.
  stagingCreatedAt DateTime?
  stagingSyncedAt  DateTime?

  // Effective limits (= plan + autoscaling delta)
  cpuLimit        Int           @default(100)
  ramLimitMb      Int           @default(1024)
  diskLimitMb     Int           @default(5120)
  ioLimitKbps     Int           @default(10240)
  iopsLimit       Int           @default(1024)
  entryProcesses  Int           @default(40)
  nprocLimit      Int           @default(20)

  // Autoscaling deltas added on top of plan base
  scaledCpu       Int           @default(0)
  scaledRamMb     Int           @default(0)
  scaledDiskMb    Int           @default(0)

  // Autoscaling block-billing episode tracking (event-driven, per 15-min block).
  // `scaledSince` = start of the current scaled episode (set when any scaled*
  // goes 0 -> >0, cleared back to NULL when it returns to baseline). Every
  // episode bills at least one full 15-min block; longer episodes bill block
  // by block (round up). `scaledBilledUntil` = end of the last billed block.
  scaledSince       DateTime?
  scaledBilledUntil DateTime?

  // Last time a backup was triggered for this account (manual "backup now" or a
  // platform-initiated snapshot). Feeds the health-score backup-freshness check.
  lastBackupAt    DateTime?

  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  serverId        String
  server          Server        @relation(fields: [serverId], references: [id])

  subscriptionId  String        @unique
  subscription    Subscription  @relation("SubscriptionAccount", fields: [subscriptionId], references: [id])

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([serverId])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// DOMAINS (additional / verifiable)
// -----------------------------------------------------------------------------

enum DomainStatus {
  PENDING
  ACTIVE
  EXPIRED
}

model Domain {
  id        String       @id @default(uuid())
  name      String       @unique
  status    DomainStatus @default(PENDING)
  registrarProvider String?
  registrarExternalId String?
  registrarStatus String?
  expiresAt DateTime?
  autoRenew Boolean @default(false)
  nameservers String[] @default([])
  transferLock Boolean @default(true)
  lastRegistrarSyncAt DateTime?

  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  checklists DomainChecklist[]
  registrarOrders DomainRegistrarOrder[]
}

enum DomainRegistrarOrderType {
  REGISTER
  TRANSFER
  RENEW
}

enum DomainRegistrarOrderStatus {
  PENDING_PAYMENT
  QUEUED
  SUBMITTED
  COMPLETED
  FAILED
  CANCELED
}

model DomainRegistrarOrder {
  id              String                     @id @default(uuid())
  domainName      String
  type            DomainRegistrarOrderType
  status          DomainRegistrarOrderStatus @default(QUEUED)
  provider        String?
  providerOrderId String?
  authCodeEnc     String?                    @db.Text
  nameservers     String[]                   @default([])
  years           Int                        @default(1)
  priceAmount     Decimal?                   @db.Decimal(10, 2)
  currency        String                     @default("PLN")
  // Wallet transaction that paid for this order (billing trail).
  walletTxId      String?
  lastError       String?                    @db.Text
  submittedAt     DateTime?
  completedAt     DateTime?

  userId          String
  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  domainId        String?
  domain          Domain?                    @relation(fields: [domainId], references: [id], onDelete: SetNull)

  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([domainName])
}

// -----------------------------------------------------------------------------
// WALLET LEDGER & PAYMENTS
// -----------------------------------------------------------------------------

/// P-8 — one-time add-on purchase (work-order or instant flag).
model PurchasedAddon {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug           String
  name           String
  amount         Decimal  @db.Decimal(10, 2)
  currency       String   @default("PLN")
  subscriptionId String?
  /// QUEUED (work-order created) | APPLIED (instant flag) | DONE
  status         String   @default("APPLIED")
  ticketId       String?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

enum WalletTxType {
  TOPUP                // User added funds (Stripe / PayU)
  REFUND
  CHARGE_SUBSCRIPTION  // Subscription renewal paid from wallet
  CHARGE_PLAN_UPGRADE  // Prorated upgrade charge on existing subscription
  CREDIT_PLAN_DOWNGRADE // Prorated downgrade credit on existing subscription
  CHARGE_AUTOSCALING   // Hourly autoscaling cost
  CHARGE_USAGE         // Other metered usage
  CHARGE_DOMAIN        // Domain registration / renewal / transfer
  ADJUSTMENT           // Manual adjustment by admin
  PROMO_CREDIT
  COMMISSION_CREDIT    // RESELL — wypłata prowizji partnerskiej do portfela
}

enum WalletTxStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model WalletTransaction {
  id              String          @id @default(uuid())

  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  type            WalletTxType
  status          WalletTxStatus  @default(COMPLETED)

  // Signed amount: positive = credit, negative = debit
  amount          Decimal         @db.Decimal(12, 2)
  currency        String          @default("PLN")
  balanceAfter    Decimal         @db.Decimal(12, 2)

  // Idempotency for top-ups / charges
  idempotencyKey  String?         @unique

  // External payment refs
  paymentProvider String?         // STRIPE, PAYU, MANUAL
  paymentRef      String?         // intent id, charge id, etc.

  subscriptionId  String?
  subscription    Subscription?   @relation("SubscriptionWalletEntries", fields: [subscriptionId], references: [id])

  description     String?
  metadata        Json?

  createdAt       DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([type])
}

model PaymentMethod {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider    String   // STRIPE
  providerRef String   // pm_xxx
  brand       String?  // visa, mastercard
  last4       String?
  expMonth    Int?
  expYear     Int?
  isDefault   Boolean  @default(false)

  createdAt   DateTime @default(now())

  @@unique([provider, providerRef])
  @@index([userId])
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

model Invoice {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  /// Numeracja wewnętrzna Verris: VFV/YYYY/MM/{0001} (resetuje się co miesiąc).
  number         String        @unique
  status         InvoiceStatus @default(DRAFT)

  /// `amount` to kwota brutto (z VAT). `netAmount`/`vatAmount`/`vatRate`
  /// dokładają rozbicie wymagane przez polską ustawę o VAT (art. 106e).
  amount         Decimal       @db.Decimal(12, 2)
  netAmount      Decimal?      @db.Decimal(12, 2)
  vatAmount      Decimal?      @db.Decimal(12, 2)
  /// Stawka VAT (procent). 23 dla VAT 23%, 0 dla zwolnionych itp.
  vatRate        Decimal?      @db.Decimal(5, 2)
  currency       String        @default("PLN")

  /// Snapshot danych sprzedawcy (Verris) w momencie wystawienia faktury.
  /// Trzymane jako JSON żeby zmiana adresu/NIP-u sprzedawcy w przyszłości
  /// nie wpłynęła na archiwalne faktury (5-letni wymóg PL).
  /// Format: { name, nip, address, city, postalCode, country, email, regon?, krs? }
  sellerSnapshot Json?
  /// Snapshot danych nabywcy (User) w momencie wystawienia. Format jak wyżej
  /// + opcjonalnie companyName, firstName, lastName.
  buyerSnapshot  Json?
  /// Lista pozycji (line items): nazwa, ilość, cena netto jednostkowa, VAT %.
  /// Format: Array<{ name, quantity, unitNet, vatRate, totalNet, totalVat, totalGross }>.
  lineItems      Json?

  /// Klucz w bucketcie `verris-invoices` MinIO. Null gdy PDF jeszcze nie
  /// został wygenerowany (pre-2.2 faktury) lub gdy korzystamy tylko z linku
  /// Stripe (`provider=STRIPE` + `hostedUrl`).
  storageKey     String?

  // External (provider) invoice
  provider       String?       // STRIPE
  providerRef    String?       // in_xxx
  hostedUrl      String?
  pdfUrl         String?

  issuedAt       DateTime?
  dueAt          DateTime?
  paidAt         DateTime?

  // B-1 — KSeF (Krajowy System e-Faktur). Faktury VERRIS (provider=null)
  // są wysyłane do KSeF; numer KSeF + UPO potwierdzają wystawienie.
  ksefStatus     KsefStatus    @default(NOT_APPLICABLE)
  /// Numer KSeF nadany przez system MF (z UPO).
  ksefNumber     String?       @unique
  /// Numer referencyjny elementu w sesji (do odpytywania statusu).
  ksefElementRef String?
  ksefSubmittedAt DateTime?
  ksefAcceptedAt  DateTime?
  ksefError      String?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([provider, providerRef])
  @@index([userId])
  @@index([ksefStatus])
}

/// B-1 — cykl życia faktury w KSeF.
enum KsefStatus {
  NOT_APPLICABLE // faktura Stripe-hosted / przed włączeniem KSeF
  PENDING        // zakwalifikowana do wysyłki
  SUBMITTED      // wysłana, czekamy na numer KSeF (status z sesji)
  ACCEPTED       // numer KSeF nadany (UPO)
  REJECTED       // odrzucona przez KSeF (walidacja) — wymaga interwencji
  OFFLINE        // wystawiona w trybie offline (awaria KSeF) — do dosłania
}

/// Atomowa numeracja faktur per (rok, miesiąc). Każda nowa faktura wykonuje
/// `INSERT ... ON CONFLICT (year, month) DO UPDATE SET seq = seq + 1
/// RETURNING seq` w jednej transakcji — Postgres gwarantuje unikalność i
/// brak luk nawet pod dużą współbieżnością. Klucz złożony (year, month).
model InvoiceCounter {
  id        String   @id @default(uuid())
  year      Int
  month     Int
  seq       Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([year, month])
}

// -----------------------------------------------------------------------------
// AUTOSCALING PRICING & EVENTS
// -----------------------------------------------------------------------------

enum AutoscalingResource {
  CPU       // additional CPU% per hour
  RAM       // additional MB per hour
  DISK      // additional disk MB per hour
  IO        // legacy — no longer offered in catalog
  TRANSFER  // legacy — no longer offered in catalog
}

model AutoscalingPriceRule {
  id             String              @id @default(uuid())
  resource       AutoscalingResource

  // Pricing model: linear "per unit per hour" (or per unit for transfer).
  unit           String              // "cpu_pct", "ram_mb", "io_kbps", "transfer_gb"
  pricePerUnit   Decimal             @db.Decimal(12, 6)
  currency       String              @default("PLN")

  // Optional tiered pricing: this rule applies above this threshold of usage
  thresholdAbove Int                 @default(0)

  isActive       Boolean             @default(true)
  validFrom      DateTime            @default(now())
  validUntil     DateTime?

  notes          String?

  createdAt      DateTime            @default(now())

  @@index([resource, isActive])
}

enum AutoscalingDirection {
  UP
  DOWN
  DISABLED
  ENABLED
}

model AutoscalingEvent {
  id             String                @id @default(uuid())

  subscriptionId String
  subscription   Subscription          @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  direction      AutoscalingDirection
  resource       AutoscalingResource?

  fromValue      Int?
  toValue        Int?
  reason         String                // e.g. "cpu_avg_above_85_pct", "wallet_balance_zero"
  costSnapshot   Decimal?              @db.Decimal(12, 6)

  createdAt      DateTime              @default(now())

  @@index([subscriptionId, createdAt])
}

// -----------------------------------------------------------------------------
// TELEMETRY (CloudLinux LVE) — bucketed metrics
// -----------------------------------------------------------------------------

model UsageMetric {
  id              String       @id @default(uuid())

  subscriptionId  String?
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  accountId       String?
  serverId        String?

  bucketStart     DateTime
  bucketDurationS Int          // 60 / 300 / 3600

  cpuUsageAvg     Float
  cpuUsageMax     Float        @default(0)
  memUsageAvgMb   Float
  memUsageMaxMb   Float        @default(0)
  diskUsageMb     Float
  ioUsageKbps     Float        @default(0)

  createdAt       DateTime     @default(now())

  @@unique([subscriptionId, bucketStart, bucketDurationS])
  @@index([accountId, bucketStart])
  @@index([serverId, bucketStart])
}

// -----------------------------------------------------------------------------
// Product operations / feature flags / customer communications
// -----------------------------------------------------------------------------

enum ProductAnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ProductAnnouncementKind {
  CHANGELOG
  INCIDENT_NOTICE
  MAINTENANCE
  PRODUCT_UPDATE
  PROMOTION
}

model FeatureFlag {
  id             String   @id @default(uuid())
  key            String   @unique
  name           String
  description    String?  @db.Text
  enabledDefault Boolean  @default(false)
  rolloutPercent Int      @default(0)
  rules          Json?
  startsAt       DateTime?
  endsAt         DateTime?

  createdById    String?
  createdBy      User?    @relation("FeatureFlagCreator", fields: [createdById], references: [id], onDelete: SetNull)

  overrides      FeatureFlagOverride[]
  planOverrides  FeatureFlagPlanOverride[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([enabledDefault, rolloutPercent])
}

model FeatureFlagOverride {
  id            String      @id @default(uuid())
  featureFlagId String
  featureFlag   FeatureFlag @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)

  userId        String
  user          User        @relation("FeatureFlagUser", fields: [userId], references: [id], onDelete: Cascade)

  enabled       Boolean
  reason        String?     @db.Text
  expiresAt     DateTime?
  createdById   String?
  createdBy     User?       @relation("FeatureFlagOverrideCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([featureFlagId, userId])
  @@index([userId])
}

model FeatureFlagPlanOverride {
  id            String      @id @default(uuid())
  featureFlagId String
  featureFlag   FeatureFlag @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)

  planId        String
  plan          Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)

  enabled       Boolean
  reason        String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([featureFlagId, planId])
  @@index([planId])
}

model ProductAnnouncement {
  id             String                    @id @default(uuid())
  kind           ProductAnnouncementKind
  status         ProductAnnouncementStatus @default(DRAFT)
  title          String
  bodyMarkdown   String                    @db.Text
  audienceRole   Role?
  featureFlagKey String?
  publishedAt    DateTime?
  expiresAt      DateTime?

  createdById    String?
  createdBy      User?                     @relation("ProductAnnouncementCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([status, publishedAt])
  @@index([kind, createdAt])
}

model ServiceHealthSnapshot {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  score          Int
  dnsOk          Boolean?
  tlsOk          Boolean?
  backupFresh    Boolean?
  incidentsOpen  Int          @default(0)
  lveOk          Boolean?
  // Panel (DirectAdmin :2222) TLS trust check. DB column kept as `phpOk` for
  // backward-compat; the field was historically misnamed.
  panelTlsOk     Boolean?     @map("phpOk")
  mailOk         Boolean?
  details        Json?
  computedAt     DateTime     @default(now())

  @@index([subscriptionId, computedAt])
}

enum HostingRestoreStatus {
  QUEUED
  RUNNING
  SAFETY_BACKUP
  RESTORING
  COMPLETED
  FAILED
}

/// Async restore of a DirectAdmin backup onto a hosting account. Processed by a
/// worker that (optionally) takes a pre-restore safety backup first, then runs
/// the selective restore. Gives the client/admin a live status in the panel.
model HostingRestoreJob {
  id                String               @id @default(uuid())
  subscriptionId    String
  subscription      Subscription         @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  requestedByUserId String
  isAdminInitiated  Boolean              @default(false)

  backupId          String
  backupFileName    String
  scopeFiles        Boolean              @default(true)
  scopeDatabases    Boolean              @default(true)
  scopeEmail        Boolean              @default(true)
  safetyBackup      Boolean              @default(true)

  status            HostingRestoreStatus @default(QUEUED)
  error             String?              @db.Text
  startedAt         DateTime?
  completedAt       DateTime?

  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([subscriptionId, createdAt])
}

enum BackupFrequency {
  OFF
  DAILY
  WEEKLY
}

/// PANEL-11 — harmonogram automatycznych backupów konta (per subskrypcja).
/// Scheduler co godzinę wyzwala DA site-backup dla pasujących, włączonych wpisów.
model BackupSchedule {
  id             String          @id @default(uuid())
  subscriptionId String          @unique
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  frequency      BackupFrequency @default(OFF)
  hour           Int             @default(3) // godzina UTC 0-23
  dayOfWeek      Int             @default(1) // 0=niedziela .. 6=sobota (dla WEEKLY)
  enabled        Boolean         @default(false)
  retainCount    Int             @default(7) // ile najnowszych kopii zostawić (0 = bez czyszczenia)

  lastRunAt      DateTime?
  lastStatus     String?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([enabled, frequency])
}

enum DomainChecklistStatus {
  PENDING
  OK
  WARNING
  FAILED
}

model DomainChecklist {
  id              String                @id @default(uuid())
  subscriptionId  String?
  subscription    Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  domainId        String?
  domain          Domain?               @relation(fields: [domainId], references: [id], onDelete: SetNull)

  hostname        String
  status          DomainChecklistStatus @default(PENDING)
  requiredRecords Json?
  observedRecords Json?
  issues          Json?
  checkedAt       DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([subscriptionId, status])
  @@index([hostname])
}

// -----------------------------------------------------------------------------
// SUPPORT (Tickets)
// -----------------------------------------------------------------------------

model Ticket {
  id              String        @id @default(uuid())
  subject         String
  message         String
  status          String        @default("OPEN")     // OPEN, IN_PROGRESS, CLOSED
  priority        String        @default("NORMAL")   // LOW, NORMAL, HIGH, URGENT
  department      String        @default("TECHNICAL") // BILLING, TECHNICAL, SALES
  // SUP-1 — temat zgłoszenia wybrany przez klienta (grupowanie + podpowiedzi KB).
  topic           String?       // HOSTING, DOMAIN, EMAIL, DNS, BILLING, SSL, OTHER

  userId          String
  user            User          @relation("ClientTickets", fields: [userId], references: [id], onDelete: Cascade)

  assignedToId    String?
  assignedTo      User?         @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: SetNull)

  replies         TicketReply[]
  attachments     TicketAttachment[]

  firstResponseAt DateTime?
  resolvedAt      DateTime?

  // SUP-4 — customer satisfaction after the ticket is closed (1-5 + optional note).
  csatRating      Int?
  csatComment     String?       @db.Text
  csatAt          DateTime?

  // Sprint 8+ / S-07 + V-10/V-11/V-12 — operacyjne pola BOK.
  slaResponseDueAt DateTime?
  slaResolveDueAt  DateTime?
  escalatedAt      DateTime?
  escalatedById    String?
  escalatedBy      User?         @relation("TicketEscalator", fields: [escalatedById], references: [id], onDelete: SetNull)
  escalationReason String?       @db.Text
  runbookKey       String?
  riskFlag         String?
  riskReason       String?       @db.Text

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([slaResponseDueAt])
  @@index([slaResolveDueAt])
  @@index([riskFlag])
}

model TicketReply {
  id        String   @id @default(uuid())
  message   String
  isStaff   Boolean  @default(false)

  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId  String

  attachments TicketAttachment[]

  createdAt DateTime @default(now())
}

/// Pliki dodane przez klienta lub staff do pierwszej wiadomości lub wątku (E‑4).
model TicketAttachment {
  id             String       @id @default(uuid())

  ticketId       String
  ticket         Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  /// Z `null` = załączone do pierwszej wiadomości klienta; inaczej rekord doklejony do `TicketReply`.
  replyId        String?
  reply          TicketReply? @relation(fields: [replyId], references: [id], onDelete: Cascade)

  originalName   String
  mimeType       String
  sizeBytes      Int
  /// Ścieżka względem katalogu upload (np. `{ticketId}/{uuid}_{name}`).
  storageKey     String       @unique

  uploadedById   String
  uploadedBy     User         @relation("TicketAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now())

  @@index([ticketId])
  @@index([replyId])
}

model CannedResponse {
  id          String   @id @default(uuid())
  title       String
  content     String   @db.Text
  // SUP-2 — temat szablonu (do filtrowania pod temat ticketu).
  topic       String?  // HOSTING, DOMAIN, EMAIL, DNS, BILLING, SSL, OTHER
  isActive    Boolean  @default(true)
  createdById String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([topic, isActive])
}

// -----------------------------------------------------------------------------
// AUDIT LOG
// -----------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(uuid())
  action         String   // SERVER_INIT, SERVER_APPROVED, SUBSCRIPTION_CREATED, etc.
  details        Json?
  ipAddress      String?
  userAgent      String?

  // The user the audit log is *about* (target)
  userId         String?
  user           User?    @relation("AuditUser", fields: [userId], references: [id], onDelete: SetNull)

  // The actor that performed the action (if different — e.g. staff impersonation)
  actorUserId    String?
  impersonatedBy String?  // Convenience field: staff_id when staff impersonates

  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

enum AiInteractionStatus {
  COMPLETED
  FAILED
}

enum AiKnowledgeAudience {
  CLIENT // visible to the client-facing hosting chatbot
  STAFF // internal-only (BOK/ops)
  ALL // usable by both client + staff assistants
}

enum AiKnowledgeStatus {
  ACTIVE
  ARCHIVED
}

/// A document/snippet added to the AI "memory" (knowledge base) used for RAG.
/// Admins/staff add hosting FAQs, policies, runbooks; the chatbot retrieves
/// relevant chunks at query time.
model AiKnowledgeDoc {
  id          String              @id @default(uuid())
  title       String
  sourceType  String              @default("TEXT") // TEXT | MARKDOWN | URL | FILE
  sourceRef   String? // URL or original filename, if any
  audience    AiKnowledgeAudience @default(ALL)
  status      AiKnowledgeStatus   @default(ACTIVE)
  charCount   Int                 @default(0)
  createdById String?
  createdBy   User?               @relation("AiKnowledgeDocAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  chunks      AiKnowledgeChunk[]

  @@index([audience, status])
  @@index([createdAt])
}

/// A retrievable chunk of a knowledge doc with its embedding vector (stored as
/// a float array; cosine similarity computed in-app). Embedding may be empty if
/// no embedding model is configured — retrieval then falls back to keyword scoring.
model AiKnowledgeChunk {
  id        String         @id @default(uuid())
  docId     String
  doc       AiKnowledgeDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  ordinal   Int
  content   String         @db.Text
  embedding Float[]
  tokens    Int            @default(0)
  createdAt DateTime       @default(now())

  @@index([docId, ordinal])
}

model AiInteractionLog {
  id            String              @id @default(uuid())
  feature       String
  provider      String
  model         String?
  status        AiInteractionStatus
  promptHash    String
  inputSummary  Json?
  output        Json?
  errorMessage  String?             @db.Text
  ticketId      String?
  subscriptionId String?
  userId        String?
  user          User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorUserId   String?
  createdAt     DateTime            @default(now())

  @@index([feature, createdAt])
  @@index([userId, createdAt])
  @@index([ticketId])
  @@index([subscriptionId])
}

// -----------------------------------------------------------------------------
// EMAIL LOG — Sprint 2.6 (admin viewer + delivery audit)
//
// Każda wysyłka, niezależnie od kanału (TRANSACTIONAL/MARKETING) i providera
// (SMTP/log), zostawia ślad w `EmailLog`. Daje to:
//   - admin viewer "co poszło do kogo" (Sprint 2.7)
//   - debug deliverability (jaki SMTP messageId, jaki bounce)
//   - audyt RODO ("dowód że poprosiłem usera o zgodę")
//   - możliwość retry przy SOFT_BOUNCE
// -----------------------------------------------------------------------------

enum EmailCategory {
  TRANSACTIONAL  // Hosting, billing, security — nie podlegają opt-out.
  MARKETING      // Newsletter, kampanie — wymaga MarketingPreferences.
  PRODUCT_UPDATE // Zmiany usługi (np. autoskalowanie) — opt-out via productUpdatesEmail.
}

enum EmailStatus {
  QUEUED          // Wstawione do EmailLog, czeka na provider.send().
  SENT            // Provider zwrócił sukces (nie znaczy że dotarło — patrz BOUNCED).
  SUPPRESSED      // Nie wysłano świadomie (user wypisał się / anonymizedAt).
  FAILED          // Provider rzucił błąd (timeout, 5xx). Można retry.
  BOUNCED         // Mailbox provider zwrócił bounce (5.x.x lub webhook).
}

model EmailLog {
  id              String         @id @default(uuid())

  /// Adres odbiorcy (snapshot — user może później zmienić email).
  toEmail         String
  /// Optional FK to user. Null gdy mail leci do osoby niezarejestrowanej
  /// (np. ticket od guesta). Zachowane SetNull żeby anonymizacja RODO nie
  /// dropowała wpisów audytowych.
  userId          String?

  category        EmailCategory
  /// Stabilny tag (np. `security.password-changed`) — wyciągany z template'a.
  tag             String?
  subject         String         @db.VarChar(512)

  status          EmailStatus    @default(QUEUED)

  providerId      String?        @db.VarChar(32)
  /// Message-Id zwrócony przez SMTP/relay — pomaga zlinkować z bounce / spam reportem.
  messageId       String?        @db.VarChar(255)
  /// Komunikat błędu providera (gdy status=FAILED|BOUNCED). Najwyżej 1024 znaki.
  errorMessage    String?        @db.VarChar(1024)

  /// Snapshot sygnałów anty-spam zastosowanych przy wysyłce.
  /// Pole JSON zamiast osobnych kolumn — łatwiej rozszerzać.
  metadata        Json?

  /// Optional FK gdy mail wysłany w ramach kampanii MarketingCampaign.
  campaignId      String?

  createdAt       DateTime       @default(now())
  sentAt          DateTime?
  updatedAt       DateTime       @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([category, status, createdAt(sort: Desc)])
  @@index([campaignId])
  @@index([tag])
}

// -----------------------------------------------------------------------------
// MARKETING CAMPAIGN — Sprint 2.6 (newsletter w panelu)
//
// Admin tworzy kampanię (subject + markdown body), wybiera segment
// (np. "all-marketing-opted-in") i klika "Send" / "Schedule".
// Worker iteruje po segment'cie z paginacją, dla każdego usera wstawia
// EmailLog (status=QUEUED) i wywołuje MailerService.send.
// -----------------------------------------------------------------------------

enum MarketingCampaignStatus {
  DRAFT          // Admin pisze, jeszcze nie zatwierdzona.
  SCHEDULED      // Zatwierdzona, scheduled na `scheduledAt`.
  SENDING        // Worker w trakcie wysyłki.
  SENT           // Wszystkie maile wstrzelone (lub flag SUPPRESSED).
  FAILED         // Worker abortował (>50% bounce w pierwszej setce).
  CANCELED       // Admin odwołał przed startem.
}

enum MarketingSegment {
  /// Wszyscy z `marketingEmail=true` w preferences.
  NEWSLETTER_OPT_IN
  /// Wszyscy z `productUpdatesEmail=true`.
  PRODUCT_UPDATES_OPT_IN
  /// Wszyscy aktywni klienci (status nie-anonymized) — UWAGA: tylko dla
  /// transactional-grade ogłoszeń (np. zmiana cennika, wymóg legal).
  /// NIE używać dla marketingu — narusza RODO i List-Unsubscribe.
  ALL_ACTIVE_USERS
}

model MarketingCampaign {
  id            String                  @id @default(uuid())
  name          String                  @db.VarChar(120)
  /// Krótki opis dla zespołu (nie wysyłany w mailu).
  description   String?                 @db.VarChar(500)

  subject       String                  @db.VarChar(255)
  /// Markdown — renderujemy przez `renderEmailShell` przy wysyłce.
  bodyMarkdown  String
  ctaLabel      String?                 @db.VarChar(80)
  ctaUrl        String?                 @db.VarChar(500)

  segment       MarketingSegment        @default(NEWSLETTER_OPT_IN)

  status        MarketingCampaignStatus @default(DRAFT)
  scheduledAt   DateTime?
  startedAt     DateTime?
  completedAt   DateTime?

  /// Ostatnio przetworzona pozycja paginacji workera (offset). Pozwala
  /// wznowić wysyłkę po crashu bez duplikatów (idempotencja po EmailLog).
  cursorOffset  Int                     @default(0)

  /// Stats — populate w trakcie wysyłki.
  recipientCount Int                    @default(0)
  sentCount      Int                    @default(0)
  suppressedCount Int                   @default(0)
  failedCount    Int                    @default(0)

  createdById    String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([status, scheduledAt])
}

// -----------------------------------------------------------------------------
// LOGIN EVENTS — security audit (Sprint 2.5)
//
// Persists every successful sign-in so we can:
//   - detect "new device" / "new IP" logins and email the user a heads-up
//   - power "Active sessions" view in account settings (future feature)
//   - support compliance investigations (e.g. RODO incident response)
//
// We deliberately do NOT track failed login attempts here — those go through
// rate limiting and are recorded in `AuditLog` only when relevant for abuse.
// -----------------------------------------------------------------------------
model LoginEvent {
  id           String   @id @default(uuid())

  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// IP at the moment of login. Stored verbatim (v4 / v6); not anonymized
  /// because it has security value within the legitimate-interest balance.
  /// Anonymized when the user requests RODO deletion.
  ipAddress    String?
  userAgent    String?
  /// Coarse country code derived from IP (best-effort, no GeoIP DB required).
  /// May be null if reverse-lookup is unavailable.
  countryCode  String?  @db.VarChar(2)

  /// Stable device fingerprint — sha256 of (userAgent || acceptLanguage ||
  /// ip-network /24). Used to identify "new device" logins. NOT a tracking
  /// id — purely deterministic from request headers.
  deviceFingerprint String?

  /// True when this fingerprint OR ip-network was unseen for this user
  /// in the last 90 days — triggers `new-device-login` email.
  isNewDevice  Boolean  @default(false)

  /// Login mechanism — useful for security forensics ("password vs OAuth").
  loginMethod  String?  @db.VarChar(32)

  createdAt    DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([deviceFingerprint])
}

// -----------------------------------------------------------------------------
// SERVICE PROBES (status page)
// -----------------------------------------------------------------------------

enum ProbeKind {
  HTTP
  HTTPS
  SMTP
  IMAP
  POP3
  MYSQL
  SSH
  DA_API
  DNS
}

enum ProbeSeverity {
  MINOR  // POP3, IMAP, SMTP — can degrade without taking the site down
  MAJOR  // HTTP, HTTPS, MYSQL, DA_API — full outage from customer POV
}

model ServiceProbe {
  id             String         @id @default(uuid())

  serverId       String
  server         Server         @relation(fields: [serverId], references: [id], onDelete: Cascade)

  kind           ProbeKind
  // Probe target — host:port for TCP, full URL for HTTP/S, hostname for DNS.
  target         String
  // Optional human-friendly label shown on the public status page.
  label          String?

  severity       ProbeSeverity  @default(MINOR)

  // Customer-facing declared SLA (e.g. 99.9000). The status page renders this
  // alongside the live computed uptime so customers see both the contractual
  // commitment and the real number we're hitting right now.
  declaredSlaPct Decimal        @default(99.9000) @db.Decimal(7, 4)

  isEnabled      Boolean        @default(true)
  // Whether to publish this probe on the public status page. Lets ops keep
  // internal-only probes (e.g. DA_API) while only HTTP/HTTPS/SMTP are public.
  isPublic       Boolean        @default(true)

  // Cached counters maintained by the engine so reads are O(1).
  consecutiveFailures Int       @default(0)
  lastSuccessAt  DateTime?
  lastFailureAt  DateTime?
  lastSampleAt   DateTime?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  samples        ProbeSample[]
  incidents      ProbeIncident[]

  @@unique([serverId, kind, target])
  @@index([serverId, kind])
  @@index([isEnabled, lastSampleAt])
}

model ProbeSample {
  id             String       @id @default(uuid())

  probeId        String
  probe          ServiceProbe @relation(fields: [probeId], references: [id], onDelete: Cascade)

  // Bucketed UTC start (1-minute by default). Lets us aggregate uptime windows
  // efficiently and dedupe duplicate writes from the same scraper window.
  bucketStart    DateTime
  bucketDurationS Int         @default(60)

  // Total/successful probe attempts within the bucket. The engine pushes one
  // server-side attempt every 30s (so 2 per bucket) plus optional node-side
  // attempts; everything aggregates here.
  totalCount     Int          @default(0)
  successCount   Int          @default(0)

  // Aggregated latency stats over the bucket (ms). Useful for the status page
  // sparkline and for tracking degradation that hasn't yet flipped to fail.
  avgLatencyMs   Int          @default(0)
  maxLatencyMs   Int          @default(0)
  // Last error code (HTTP status, errno, etc.) — null when bucket is healthy.
  errorCode      String?

  createdAt      DateTime     @default(now())

  @@unique([probeId, bucketStart, bucketDurationS])
  @@index([probeId, bucketStart])
}

enum IncidentSeverity {
  MINOR
  MAJOR
}

enum IncidentStatus {
  OPEN
  RESOLVED
}

model ProbeIncident {
  id             String           @id @default(uuid())

  probeId        String
  probe          ServiceProbe     @relation(fields: [probeId], references: [id], onDelete: Cascade)

  severity       IncidentSeverity
  status         IncidentStatus   @default(OPEN)

  // Operator-supplied summary — the engine fills a default ("HTTP probe for
  // example.com failing") that admin can override later from /admin/status.
  title          String
  // Optional public-facing description shown on the status page.
  publicMessage  String?

  startedAt      DateTime         @default(now())
  resolvedAt     DateTime?
  // Snapshot of how the incident was detected (consecutive failures, sample
  // ids referenced, etc.) for post-mortem.
  detectionMeta  Json?
  // #11 — znacznik przetworzenia kredytów SLA (raz na incydent, po RESOLVED).
  slaCreditedAt  DateTime?

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  slaCredits     SlaCredit[]

  @@index([probeId, status])
  @@index([status, startedAt])
  @@index([status, slaCreditedAt])
}

// -----------------------------------------------------------------------------
// #11 — Kredyty SLA: automatyczne uznanie portfela za przestój infrastruktury.
// Jeden rekord = jeden kredyt dla (incydent × subskrypcja). Idempotencja przez
// @@unique. Powiązany wpis w WalletTransaction tworzy WalletLedgerService.
// -----------------------------------------------------------------------------
model SlaCredit {
  id             String        @id @default(uuid())

  incidentId     String
  incident       ProbeIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  subscriptionId String
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Czas przestoju zaliczony do kredytu (sekundy).
  downtimeS      Int
  /// Kwota uznania w walucie portfela (K).
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("PLN")

  createdAt      DateTime      @default(now())

  @@unique([incidentId, subscriptionId])
  @@index([userId])
  @@index([subscriptionId])
}

// -----------------------------------------------------------------------------
// E-8 — SECURITY: login attempts
// -----------------------------------------------------------------------------

/// Every login attempt — success or failure — is recorded for rate-limiting,
/// post-mortem, and SIEM-style detection. Pruned by the suspicious-activity
/// scheduler (rolling 30-day retention).
model LoginAttempt {
  id         String   @id @default(uuid())

  email      String   // case-folded
  ip         String?
  userAgent  String?

  succeeded  Boolean
  /// Contributing reason (`bad_password`, `unknown_user`, `2fa_failed`,
  /// `too_many_attempts`). Free-form so the auth code can label nuanced
  /// failure modes without a schema migration.
  reason     String?

  createdAt  DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// -----------------------------------------------------------------------------
// C-14 — PROMO CODES
// -----------------------------------------------------------------------------

enum PromoKind {
  /// Fixed amount credited to the wallet (e.g. 50.00 PLN signup bonus).
  FIXED_CREDIT
  /// Percentage of the next top-up (e.g. +20% on next deposit).
  /// `value` is the percentage as an integer (0..100).
  PERCENT_BONUS
  /// Percentage off the first service purchase (and optionally renewals).
  /// `value` is the discount percent (1..100).
  SERVICE_PERCENT_OFF
}

/// Marketing / referral codes redeemable by users for wallet credit.
/// One code can have many redemptions up to `maxRedemptions`; per-user
/// redemption is enforced via the unique `(promoCodeId, userId)` index on
/// `PromoRedemption`.
model PromoCode {
  id                String           @id @default(uuid())
  code              String           @unique
  kind              PromoKind        @default(FIXED_CREDIT)
  value             Decimal          @db.Decimal(12, 2)
  currency          String           @default("PLN")

  /// Optional human-readable description shown on the receipt + audit log.
  description       String?

  /// Lifetime redemption cap. `null` = unlimited.
  maxRedemptions    Int?
  /// Times redeemed across all users. Cheap counter, source of truth is the
  /// row count in `PromoRedemption`.
  redemptionCount   Int              @default(0)

  /// Optional time bounds.
  validFrom         DateTime?
  validTo           DateTime?

  /// Soft-disable flag — set by admin when a code has to be killed mid-flight
  /// without breaking past redemptions.
  active            Boolean          @default(true)

  /// For `SERVICE_PERCENT_OFF`: when true, each wallet renewal uses the same % off list price.
  appliesToRenewals Boolean          @default(false)

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  redemptions       PromoRedemption[]
  subscriptionsWithPromo Subscription[] @relation("SubscriptionAppliedPromo")

  @@index([active, validFrom, validTo])
}

model PromoRedemption {
  id              String      @id @default(uuid())

  promoCodeId     String
  promoCode       PromoCode   @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Amount actually credited (resolved at redemption time — for percentage
  /// codes this is computed from a top-up reference).
  amountCredited  Decimal     @db.Decimal(12, 2)
  currency        String      @default("PLN")

  /// Pointer to the wallet transaction that materialized the credit.
  walletTxId      String?     @unique

  subscriptionId  String?

  redeemedAt      DateTime    @default(now())

  @@unique([promoCodeId, userId])
  @@index([subscriptionId])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// C-9 — WALLET AUTO TOP-UP
// -----------------------------------------------------------------------------

/// User-level rule that automatically tops up the wallet via the saved
/// PaymentMethod whenever the balance falls below `threshold`. Evaluated by
/// the autoscaling/usage charge path (post-debit hook): if balance < threshold
/// and `enabled = true`, we enqueue an off-session Stripe `PaymentIntent` for
/// `topupAmount` against `paymentMethodId`. The `cooldownUntil` field
/// throttles retries after a failure (so we don't hammer the user's card).
model WalletAutoTopup {
  id                String          @id @default(uuid())

  userId            String          @unique
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  enabled           Boolean         @default(false)

  /// In wallet currency. When `walletBalance < threshold`, top-up triggers.
  threshold         Decimal         @db.Decimal(12, 2)
  /// Amount to charge per top-up.
  topupAmount       Decimal         @db.Decimal(12, 2)
  currency          String          @default("PLN")

  /// Reference to the saved PaymentMethod row (Stripe). Null = use default.
  paymentMethodId   String?

  /// Bookkeeping for the scheduler: when did the last attempt run + did it
  /// succeed. Used to populate `cooldownUntil` on consecutive failures.
  lastAttemptAt     DateTime?
  lastAttemptOk     Boolean?
  lastAttemptError  String?
  cooldownUntil     DateTime?

  /// Lifetime stats — handy for the Auto Top-up UI dashboard.
  totalToppedUpAmount Decimal       @default(0) @db.Decimal(14, 2)
  totalToppedUpCount  Int           @default(0)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([enabled, cooldownUntil])
}

// =============================================================================
// SPRINT 1 — LEGAL & RODO
// -----------------------------------------------------------------------------
// Versioned legal documents (terms, privacy, cookies, DPA), per-user consent
// audit trail (with IP/UA), marketing opt-ins, GDPR data-subject requests
// (Art. 17 deletion, Art. 20 export). Drafts of the actual document content
// live in `docs/legal/drafts/` and are imported by `prisma db seed` once
// lawyer-reviewed.
// =============================================================================

enum LegalDocumentKind {
  TERMS
  PRIVACY
  COOKIES
  DPA
}

/// Versioned legal document content (Markdown) shown under `/legal/<kind>`
/// in the client panel and status page. Multiple versions per kind/locale
/// retained for transparency — only one row has `isCurrent = true` per
/// (kind, locale).
model LegalDocument {
  id              String            @id @default(uuid())
  kind            LegalDocumentKind
  /// Semver string ("1.0.0", "1.1.0", "2.0.0"). Manually assigned on publish.
  version         String
  /// IETF locale, e.g. "pl", "en". Polish is canonical.
  locale          String            @default("pl")

  /// Display title, e.g. "Regulamin świadczenia usług hostingowych Verris".
  title           String

  /// Full Markdown content. Rendered server-side via `react-markdown` with
  /// strict allowlist. Never stored as raw HTML.
  contentMarkdown String            @db.Text

  /// User-friendly changelog explaining what's new vs prior version.
  /// Shown in the re-consent modal so customers know what they're accepting.
  changelogMarkdown String?         @db.Text

  /// Effective publication date. May be in the future for staged rollouts.
  publishedAt     DateTime          @default(now())

  publishedById   String?
  publishedBy     User?             @relation("LegalDocPublisher", fields: [publishedById], references: [id], onDelete: SetNull)

  /// Only one row per (kind, locale) is `true`. Toggled by the publish action
  /// in admin → Compliance.
  isCurrent       Boolean           @default(false)

  createdAt       DateTime          @default(now())

  consents        UserConsent[]

  @@unique([kind, version, locale])
  @@index([kind, locale, isCurrent])
}

enum ConsentSource {
  /// Granted during initial registration form.
  REGISTRATION
  /// Granted via the re-consent modal after a new version was published.
  RE_CONSENT
  /// Granted/withdrawn from the settings → Privacy tab.
  SETTINGS
  /// Manual override by an admin (e.g. UODO request, customer phone call).
  ADMIN_MANUAL
}

/// Append-only audit trail of every consent grant or withdrawal (RODO Art. 7
/// requires being able to demonstrate that consent was given). One row per
/// kind+version+grant — withdrawals create a *new* row with `withdrawnAt` set
/// instead of mutating the original (immutable history).
model UserConsent {
  id              String            @id @default(uuid())

  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  documentKind    LegalDocumentKind
  documentVersion String
  /// Locale of the document version the user accepted (snapshot in case the
  /// document was later renamed/translated).
  locale          String            @default("pl")

  /// FK to the actual `LegalDocument` row that was active at grant time.
  /// Optional because old `ADMIN_MANUAL` rows might point to versions we
  /// later soft-deleted.
  documentId      String?
  document        LegalDocument?    @relation(fields: [documentId], references: [id], onDelete: SetNull)

  grantedAt       DateTime          @default(now())
  /// Set if/when the user explicitly withdraws this consent. Mainly relevant
  /// for `MARKETING` style consents — `TERMS`/`PRIVACY` cannot be withdrawn
  /// while account is active (in that case use account deletion).
  withdrawnAt     DateTime?

  /// Snapshot of the request origin at grant time. Mandatory for proof.
  ipAddress       String?
  userAgent       String?

  source          ConsentSource     @default(SETTINGS)

  createdAt       DateTime          @default(now())

  @@index([userId, documentKind, grantedAt])
  @@index([documentKind, documentVersion])
}

/// Per-user marketing/analytics opt-ins. Transactional and security e-mails
/// are *not* user-controllable and have no flag here — they're always sent
/// while the account is active (legal basis: contract performance).
model MarketingPreferences {
  userId               String   @id
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// General product newsletter, monthly digest.
  marketingEmail       Boolean  @default(false)
  /// New feature announcements and product updates.
  productUpdatesEmail  Boolean  @default(false)
  /// Third-party / partner promo offers (only with explicit double opt-in).
  partnerOffersEmail   Boolean  @default(false)
  /// Login alerts on new IP / device. Default `true` because security-positive,
  /// but user can disable in settings.
  loginAlertsEmail     Boolean  @default(true)

  /// Token used in `List-Unsubscribe` mail header for one-click opt-out
  /// (RFC 8058). Random hex 32B, rotated on every preference reset.
  unsubscribeToken     String   @unique

  updatedAt            DateTime @updatedAt
  createdAt            DateTime @default(now())
}

enum DataExportStatus {
  PENDING      // Queued, worker hasn't picked it up yet.
  GENERATING   // Worker is building the ZIP.
  READY        // ZIP ready, downloadable until `expiresAt`.
  EXPIRED      // Past `expiresAt`, file deleted.
  FAILED       // Worker errored; admin can retry.
}

/// GDPR Art. 20 — right to data portability. User clicks "Download my data"
/// in settings → this row is created → background worker fetches user data,
/// builds a ZIP, marks `READY`. User is e-mailed a one-time download link
/// expiring after 7 days.
model DataExportRequest {
  id              String            @id @default(uuid())

  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  status          DataExportStatus  @default(PENDING)

  requestedAt     DateTime          @default(now())
  startedAt       DateTime?
  completedAt     DateTime?

  /// Random hex 32B — included in the download URL. Single-use; consumed
  /// on first successful download.
  downloadToken   String?           @unique
  downloadedAt    DateTime?

  /// Filesystem path or S3 key where the ZIP is stored. Cleared when the
  /// row transitions to `EXPIRED`.
  storageKey      String?

  /// Filesize in bytes (for showing "ZIP, 14.2 MB" in UI).
  sizeBytes       Int?

  /// `now + 7d` once `READY`.
  expiresAt       DateTime?

  errorMessage    String?

  @@index([userId, requestedAt])
  @@index([status])
}

/// GDPR Art. 17 — right to be forgotten. User initiates from settings,
/// 14-day grace period during which they can cancel. After grace, the
/// `account-deletion.scheduler` cron anonymizes PII and cancels Stripe
/// subscriptions. Invoice/wallet rows are kept (5y PL accounting law)
/// but with `userId` pointing to an anonymized `User` row.
model AccountDeletionRequest {
  /// One active request per user — once anonymized the user can't request
  /// again because the row is locked read-only.
  userId             String    @id
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  requestedAt        DateTime  @default(now())
  /// `requestedAt + 14 days`. Cron compares against `now` to trigger
  /// anonymization. Adjusted automatically if Stripe billing cycle ends
  /// later (we wait for final invoice before anonymizing).
  scheduledFor       DateTime

  /// User cancels → row stays for audit but is no longer actionable.
  cancelledAt        DateTime?

  anonymizedAt       DateTime?
  anonymizedById     String?
  anonymizedByAdmin  User?     @relation("AccountDeletionAdminAnonymizer", fields: [anonymizedById], references: [id], onDelete: SetNull)

  /// Optional free-form text the user wrote in the deletion modal. Useful
  /// for product/CX feedback.
  reason             String?

  @@index([scheduledFor, anonymizedAt])
}

/// Global product configuration (EKO thresholds, session timeouts, badge rules).
// -----------------------------------------------------------------------------
// MAIL-4 — poczta zespołu @verris.pl (Postfix + Dovecot + SOGo)
// -----------------------------------------------------------------------------

enum ControlPlaneMailboxKind {
  SYSTEM
  STAFF
  ALIAS_ONLY
}

enum ControlPlaneMailboxStatus {
  ACTIVE
  SUSPENDED
  PENDING_MIGRATION
}

enum ControlPlaneSystemAddressRole {
  NOREPLY
  SUPPORT
  SECURITY
  RODO
  BILLING
  DMARC_RUA
  PANEL
}

model ControlPlaneMailbox {
  id           String                    @id @default(uuid())
  localPart    String
  domain       String                    @default("verris.pl")
  email        String                    @unique
  kind         ControlPlaneMailboxKind
  status       ControlPlaneMailboxStatus @default(ACTIVE)
  displayName  String?
  userId       String?                   @unique
  user         User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  quotaMb      Int                       @default(1024)
  usedBytes    BigInt                    @default(0)
  imapEnabled  Boolean                   @default(true)
  /// Dovecot {BLF-CRYPT} — null dla SYSTEM / ALIAS_ONLY
  passwordHash String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  createdById  String?

  aliases      ControlPlaneMailAlias[]   @relation("MailboxAliasTarget")
  forwards     ControlPlaneMailForward[]

  @@unique([localPart, domain])
  @@index([status, kind])
}

model ControlPlaneMailAlias {
  id         String              @id @default(uuid())
  aliasEmail String              @unique
  targetId   String
  target     ControlPlaneMailbox @relation("MailboxAliasTarget", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt  DateTime            @default(now())
}

model ControlPlaneMailForward {
  id                String              @id @default(uuid())
  mailboxId         String
  mailbox           ControlPlaneMailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  forwardTo         String
  confirmedAt       DateTime?
  confirmationToken String?             @unique
  keepCopy          Boolean             @default(true)
  createdAt         DateTime            @default(now())

  @@index([mailboxId])
}

model ControlPlaneSystemAddress {
  role      ControlPlaneSystemAddressRole @id
  email     String                        @unique
  mailboxId String?
  updatedAt DateTime                      @updatedAt
}

model PlatformSetting {
  key             String   @id
  value           String   @db.Text
  updatedAt       DateTime @updatedAt
  updatedByUserId String?
  updatedBy       User?    @relation("PlatformSettingUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("platform_settings")
}

enum ReferralProgramEnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Partner / referral program — user must apply and be approved before sharing link.
model ReferralProgramEnrollment {
  id               String                          @id @default(uuid())
  userId           String                          @unique
  user             User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           ReferralProgramEnrollmentStatus @default(PENDING)
  appliedAt        DateTime                        @default(now())
  reviewedAt       DateTime?
  reviewedByUserId String?
  reviewedBy       User?                           @relation("ReferralEnrollmentReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewNote       String?                         @db.Text
  termsVersion     String?

  @@index([status, appliedAt])
}

/// Audit F-16: deduplication of Stripe webhook deliveries. Money movements are
/// already idempotent at the ledger level — this additionally makes the
/// stateful handlers (subscription sync, counters, e-mails) replay-safe.
model StripeWebhookEvent {
  id        String   @id @default(uuid())
  /// Stripe event id (`evt_…`) — unique across retries of the same delivery.
  eventId   String   @unique
  type      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// ETAP 8 — WireGuard VPN dla paneli wewnętrznych (admin/staff).
/// Przechowujemy WYŁĄCZNIE klucz publiczny peera — klucz prywatny jest
/// generowany w API i zwracany dokładnie raz (config do pobrania).
/// PSK jest szyfrowany KMS (potrzebny do renderu konfiguracji serwera).
model VpnPeer {
  id            String    @id @default(uuid())
  /// Etykieta operatora, np. "Dominik — laptop".
  name          String
  /// Opcjonalne powiązanie z kontem staff/admin (informacyjne).
  ownerEmail    String?
  publicKey     String    @unique
  presharedKeyEnc String?
  /// Adres w subnecie VPN, np. 10.88.0.7/32 (część przed maską).
  assignedIp    String    @unique
  enabled       Boolean   @default(true)
  revokedAt     DateTime?
  revokedById   String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([enabled])
}

/// B3 — monitoring strony klienta (opt-in per usługa). Prosty model: jeden
/// monitor HTTP per subskrypcja, sprawdzany przez control-plane co minutę.
enum SiteMonitorStatus {
  UNKNOWN
  UP
  DOWN
}

model SiteMonitor {
  id               String            @id @default(uuid())
  subscriptionId   String            @unique
  subscription     Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  enabled          Boolean           @default(true)
  /// MON-6 — czy wysyłać klientowi maile o awarii/powrocie/SSL (monitoring działa
  /// niezależnie). Płatne powiadomienia rozliczeniowe idą zawsze.
  notifyEmail      Boolean           @default(true)
  /// Pełny URL sprawdzany przez monitor (https://<domena glowna>).
  url              String
  lastStatus       SiteMonitorStatus @default(UNKNOWN)
  consecutiveFails Int               @default(0)
  lastCheckedAt    DateTime?
  lastHttpStatus   Int?
  /// MON-4 — czas odpowiedzi ostatniego udanego sprawdzenia (ms).
  lastResponseMs   Int?
  lastError        String?
  downSince        DateTime?
  // MON-5 — wygasanie certyfikatu TLS (odczyt przez handshake, nie z DA).
  tlsExpiresAt        DateTime?
  tlsCheckedAt        DateTime?
  /// Wartość `tlsExpiresAt`, dla której wysłaliśmy już ostrzeżenie (anty-spam;
  /// po odnowieniu certyfikatu zmienia się i ostrzeżenie może pójść ponownie).
  tlsExpiryNotifiedFor DateTime?
  // MON-3 — płatny tier monitoringu (szybsze sprawdzanie), rozliczany
  // miesięcznie z portfela. Gdy false → darmowy interwał. Przy braku środków
  // scheduler ustawia paidTier=false (powrót do darmowego — usługa nie znika).
  paidTier              Boolean   @default(false)
  paidActivatedAt       DateTime?
  /// Następna miesięczna opłata za płatny monitoring.
  paidNextChargeAt      DateTime?
  /// Klient wyłączył odnawianie — szybki tier do końca opłaconego okresu.
  paidCancelAtPeriodEnd Boolean   @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  events           SiteMonitorEvent[]

  @@index([enabled])
  @@index([paidTier, paidNextChargeAt])
}

enum SiteMonitorEventType {
  DOWN
  RECOVERED
}

model SiteMonitorEvent {
  id         String               @id @default(uuid())
  monitorId  String
  monitor    SiteMonitor          @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  type       SiteMonitorEventType
  message    String?
  httpStatus Int?
  /// Dla RECOVERED: czas trwania awarii w sekundach.
  durationS  Int?
  createdAt  DateTime             @default(now())

  @@index([monitorId, createdAt])
}

// ===========================================================================
// VPS / Cloud (resale via Hetzner Cloud API)
// ===========================================================================

enum VpsStatus {
  PROVISIONING // create requested, Hetzner building
  RUNNING
  STOPPED
  REBOOTING
  ERROR        // provisioning/action failed
  DELETING
  DELETED
}

/// A sellable VPS plan mapped to a concrete Hetzner Cloud server type.
model VpsPlan {
  id                String    @id @default(uuid())
  slug              String    @unique
  name              String
  description       String?

  // Hetzner mapping
  hetznerServerType String    // e.g. "cx22"
  hetznerImage      String    @default("ubuntu-24.04")
  location          String    @default("nbg1") // nbg1/fsn1/hel1/ash/hil

  // Display specs
  vcpu              Int
  ramGb             Int
  diskGb            Int
  trafficTb         Int       @default(20)

  priceMonthly      Decimal   @db.Decimal(10, 2)
  currency          String    @default("PLN")

  isPublic          Boolean   @default(true)
  isActive          Boolean   @default(true)
  sortOrder         Int       @default(0)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  instances         VpsInstance[]

  @@index([isPublic, isActive])
}

/// Customer SSH public key, reusable across VPS orders. Uploaded to the
/// Hetzner project lazily on first use (`hetznerKeyId` cached afterwards).
model SshKey {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  publicKey    String   @db.Text
  fingerprint  String
  hetznerKeyId String?
  createdAt    DateTime @default(now())

  @@unique([userId, fingerprint])
  @@index([userId])
}

/// A provisioned VPS owned by a customer, backed by a Hetzner server.
model VpsInstance {
  id               String    @id @default(uuid())

  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId           String
  plan             VpsPlan   @relation(fields: [planId], references: [id])

  /// Customer-facing hostname/label.
  name             String

  status           VpsStatus @default(PROVISIONING)

  // Hetzner references
  hetznerServerId  String?   @unique
  location         String?
  ipv4             String?
  ipv6             String?
  /// Initial root password (AES-256-GCM at-rest); shown once to the customer.
  rootPasswordEnc  String?

  // Pricing snapshot + period (monthly prepaid from wallet)
  priceMonthly     Decimal   @db.Decimal(10, 2)
  currency         String    @default("PLN")
  currentPeriodEnd DateTime?

  lastError        String?   @db.Text

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  @@index([userId, createdAt])
  @@index([status])
}

// =====================================================================
// RESELL — Program partnerski (afiliacja). Partner = zatwierdzony uczestnik
// (ReferralProgramEnrollment.status = APPROVED). Klient polecony (User.referredByUserId)
// generuje prowizję % od każdej realnej płatności (CHARGE_SUBSCRIPTION) oraz
// bonusy „darmowy hosting za N poleceń". Wypłata: do portfela lub na konto.
// =====================================================================

enum PartnerCommissionKind {
  RECURRING_PCT    // % od płatności poleconego klienta
  MILESTONE_BONUS  // bonus za osiągnięcie progu N aktywnych poleceń
}

enum PartnerCommissionStatus {
  PENDING    // naliczona, w okresie karencji (ochrona przed zwrotem)
  AVAILABLE  // dojrzała, gotowa do wypłaty
  PAID       // wypłacona (do portfela lub przelewem)
  CANCELED   // anulowana (np. zwrot płatności klienta)
}

model PartnerCommission {
  id             String                  @id @default(uuid())

  partnerUserId  String
  partner        User                    @relation("PartnerCommissions", fields: [partnerUserId], references: [id], onDelete: Cascade)

  referredUserId String?
  referred       User?                   @relation("ReferredCommissions", fields: [referredUserId], references: [id], onDelete: SetNull)

  kind           PartnerCommissionKind   @default(RECURRING_PCT)
  /// Klucz idempotencji: "tx:<walletTxId>" dla % lub "ms:<partnerId>:<n>" dla bonusu.
  dedupeKey      String                  @unique

  /// Kwota płatności klienta, od której liczona jest prowizja (dla RECURRING_PCT).
  baseAmount     Decimal?                @db.Decimal(12, 2)
  /// Zastosowany procent prowizji (snapshot z chwili naliczenia).
  pct            Int?
  /// Faktyczna kwota prowizji/bonusu w walucie portfela.
  amount         Decimal                 @db.Decimal(12, 2)
  currency       String                  @default("PLN")

  status         PartnerCommissionStatus @default(PENDING)
  /// Kiedy prowizja dojrzewa (PENDING → AVAILABLE).
  availableAt    DateTime?

  payoutId       String?
  payout         PartnerPayout?          @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  description    String?
  createdAt      DateTime                @default(now())

  @@index([partnerUserId, status])
  @@index([referredUserId])
}

enum PartnerPayoutMethod {
  WALLET  // kredyt do portfela partnera (natychmiast)
  BANK    // wypłata przelewem (wymaga obsługi przez admina)
}

enum PartnerPayoutStatus {
  REQUESTED  // zlecona przez partnera (BANK)
  PAID       // wypłacona
  REJECTED   // odrzucona przez admina (prowizje wracają do AVAILABLE)
}

model PartnerPayout {
  id                String              @id @default(uuid())

  partnerUserId     String
  partner           User                @relation("PartnerPayouts", fields: [partnerUserId], references: [id], onDelete: Cascade)

  method            PartnerPayoutMethod
  amount            Decimal             @db.Decimal(12, 2)
  currency          String              @default("PLN")
  status            PartnerPayoutStatus @default(REQUESTED)

  /// Snapshot numeru konta dla wypłaty BANK (z profilu nabywcy partnera).
  bankAccount       String?
  /// Powiązana transakcja portfela przy method=WALLET (kredyt COMMISSION_CREDIT).
  walletTxId        String?

  note              String?             @db.Text
  requestedAt       DateTime            @default(now())
  processedAt       DateTime?
  processedByUserId String?

  commissions       PartnerCommission[]

  @@index([partnerUserId, status])
  @@index([status, requestedAt])
}
