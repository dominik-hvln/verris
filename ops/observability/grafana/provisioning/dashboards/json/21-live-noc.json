{
  "annotations": { "list": [] },
  "editable": false,
  "description": "Live / NOC — podgląd na żywo (odświeżanie 5 s). Stan floty, incydenty, kolejka, błędy API, backup, tickety. Wszystko z metryk verris_* (Prometheus).",
  "panels": [
    { "type": "stat", "title": "Serwery aktywne", "id": 1, "gridPos": { "h": 5, "w": 4, "x": 0, "y": 0 },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "verris_servers_total{status=\"ACTIVE\"}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" } } } },
    { "type": "stat", "title": "Bez heartbeatu", "id": 2, "gridPos": { "h": 5, "w": 4, "x": 4, "y": 0 },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "verris_servers_stale_heartbeat", "refId": "A" } ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green" }, { "color": "red", "value": 1 } ] } } } },
    { "type": "stat", "title": "Otwarte incydenty", "id": 3, "gridPos": { "h": 5, "w": 4, "x": 8, "y": 0 },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "sum(verris_incidents_open)", "refId": "A" } ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green" }, { "color": "red", "value": 1 } ] } } } },
    { "type": "stat", "title": "Tickety bez odpowiedzi", "id": 4, "gridPos": { "h": 5, "w": 4, "x": 12, "y": 0 },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "verris_tickets_awaiting_first_response_total", "refId": "A" } ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green" }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 } ] } } } },
    { "type": "stat", "title": "Provisioning w toku", "id": 5, "gridPos": { "h": 5, "w": 4, "x": 16, "y": 0 },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "verris_provisioning_pending", "refId": "A" } ] },
    { "type": "stat", "title": "Błędy 5xx /s", "id": 6, "gridPos": { "h": 5, "w": 4, "x": 20, "y": 0 },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "sum(rate(verris_http_requests_total{status_class=\"5xx\"}[1m]))", "refId": "A" } ],
      "fieldConfig": { "defaults": { "decimals": 3, "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green" }, { "color": "red", "value": 0.1 } ] } } } },
    { "type": "timeseries", "title": "Ruch API 4xx / 5xx (na żywo)", "id": 7, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "sum(rate(verris_http_requests_total{status_class=~\"4xx|5xx\"}[1m])) by (status_class)", "legendFormat": "{{status_class}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "reqps" } } },
    { "type": "timeseries", "title": "Kolejka provisioningu (na żywo)", "id": 8, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "verris_provisioning_pending", "legendFormat": "oczekujące", "refId": "A" } ] },
    { "type": "stat", "title": "Wiek ostatniego backupu DB", "id": 9, "gridPos": { "h": 5, "w": 8, "x": 0, "y": 13 },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "verris_backup_latest_age_seconds", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green" }, { "color": "red", "value": 90000 } ] } } } },
    { "type": "stat", "title": "Migracje FAILED", "id": 10, "gridPos": { "h": 5, "w": 8, "x": 8, "y": 13 },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "verris_migration_worker_jobs_failed", "refId": "A" } ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green" }, { "color": "red", "value": 1 } ] } } } },
    { "type": "stat", "title": "Webhooki statusu — najstarszy pending", "id": 11, "gridPos": { "h": 5, "w": 8, "x": 16, "y": 13 },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "verris_status_webhook_oldest_pending_seconds", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "s" } } }
  ],
  "refresh": "5s", "schemaVersion": 36, "style": "dark", "tags": [ "verris", "live", "noc" ], "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" }, "title": "Live / NOC", "uid": "verris-live", "version": 1
}
