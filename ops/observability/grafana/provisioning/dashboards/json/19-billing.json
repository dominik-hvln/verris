{
  "annotations": { "list": [] },
  "editable": false,
  "description": "Billing / Przychód — przepływy portfela, faktury, zaległości. Źródła: verris_wallet_amount_30d_pln / verris_invoices_24h_total (Prometheus) + wallet_transaction_safe / invoice_safe (Postgres). Uwaga: MRR liczy API BusinessMetricsService (priceAmount) — nie ma go pewnie w subscription_safe.",
  "panels": [
    { "type": "stat", "title": "Doładowania (30 dni)", "id": 1, "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "verris_wallet_amount_30d_pln{type=\"TOPUP\"}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "currencyPLN" } } },
    { "type": "stat", "title": "Przychód autoskalowania (30 dni)", "id": 2, "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "verris_wallet_amount_30d_pln{type=\"CHARGE_AUTOSCALING\"}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "currencyPLN" } } },
    { "type": "stat", "title": "Faktury (24h)", "id": 3, "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "verris_invoices_24h_total", "refId": "A" } ] },
    { "type": "stat", "title": "Faktury po terminie (niezapłacone)", "id": 4, "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "postgres", "uid": "Verris-DB (RO)" },
      "targets": [ { "format": "table", "rawQuery": true, "rawSql": "SELECT count(*) AS po_terminie FROM invoice_safe WHERE \"paidAt\" IS NULL AND \"dueAt\" IS NOT NULL AND \"dueAt\" < NOW()", "refId": "A" } ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green" }, { "color": "red", "value": 1 } ] } } } },
    { "type": "barchart", "title": "Przepływy portfela wg typu (30 dni)", "id": 5, "gridPos": { "h": 8, "w": 8, "x": 0, "y": 4 },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "verris_wallet_amount_30d_pln", "legendFormat": "{{type}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "currencyPLN" } } },
    { "type": "timeseries", "title": "Dzienny przepływ portfela (30 dni)", "id": 6, "gridPos": { "h": 8, "w": 16, "x": 8, "y": 4 },
      "datasource": { "type": "postgres", "uid": "Verris-DB (RO)" },
      "targets": [ { "format": "time_series", "rawQuery": true, "rawSql": "SELECT date_trunc('day', \"createdAt\") AS time, type AS metric, sum(amount) AS value FROM wallet_transaction_safe WHERE \"createdAt\" > NOW() - INTERVAL '30 days' GROUP BY 1, 2 ORDER BY 1", "refId": "A" } ] },
    { "type": "timeseries", "title": "Przychód — opłacone faktury / dzień (90 dni)", "id": 7, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "postgres", "uid": "Verris-DB (RO)" },
      "targets": [ { "format": "time_series", "rawQuery": true, "rawSql": "SELECT date_trunc('day', \"paidAt\") AS time, sum(amount) AS \"opłacone (PLN)\" FROM invoice_safe WHERE \"paidAt\" > NOW() - INTERVAL '90 days' GROUP BY 1 ORDER BY 1", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "currencyPLN" } } },
    { "type": "table", "title": "Faktury wg statusu", "id": 8, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "postgres", "uid": "Verris-DB (RO)" },
      "targets": [ { "format": "table", "rawQuery": true, "rawSql": "SELECT status, count(*) AS liczba, sum(amount) AS suma_pln FROM invoice_safe GROUP BY 1 ORDER BY 2 DESC", "refId": "A" } ] }
  ],
  "schemaVersion": 36, "style": "dark", "tags": [ "verris", "billing" ], "templating": { "list": [] },
  "time": { "from": "now-90d", "to": "now" }, "title": "Billing / Przychód", "uid": "verris-billing", "version": 1
}
