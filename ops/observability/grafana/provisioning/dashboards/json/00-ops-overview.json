{
  "annotations": { "list": [] },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    { "title": "Logi kontenerów", "url": "/d/verris-logs/logs-explorer", "type": "link", "icon": "doc" },
    { "title": "Control plane health", "url": "/d/verris-control-plane/control-plane-health", "type": "link" },
    { "title": "Biznes", "url": "/d/verris-business/business", "type": "link" }
  ],
  "panels": [
    {
      "type": "text",
      "title": "Szybkie linki",
      "id": 1,
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "**Panele:** [panel.verris.pl](https://panel.verris.pl) · [staff.verris.pl](https://staff.verris.pl) · [admin.verris.pl](https://admin.verris.pl) · [status.verris.pl](https://status.verris.pl) · [api /healthz](https://api.verris.pl/healthz)\n\n**Grafana:** [Logi](/d/verris-logs) · [Storage/backup](/d/verris-ops-storage) · [Compute fleet](/d/verris-fleet) — węzły pojawią się po GO-HOST."
      }
    },
    {
      "type": "stat",
      "title": "Klienci (USER)",
      "id": 10,
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 4 },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "verris_users_total{role=\"USER\"}", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Subskrypcje ACTIVE",
      "id": 11,
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 4 },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "verris_subscriptions_total{status=\"ACTIVE\"}", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Tickety OPEN",
      "id": 12,
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 4 },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "sum(verris_tickets_total{status=~\"OPEN|IN_PROGRESS\"})", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green" }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 20 }] } } }
    },
    {
      "type": "stat",
      "title": "Skrzynki @verris.pl",
      "id": 13,
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 4 },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "sum(verris_mailboxes_total{status=\"ACTIVE\"})", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Maile FAILED (24h)",
      "id": 14,
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 4 },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "verris_email_log_24h_total{status=\"FAILED\"}", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green" }, { "color": "red", "value": 1 }] } } }
    },
    {
      "type": "stat",
      "title": "Backup DB (wiek)",
      "id": 15,
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 4 },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "verris_backup_latest_age_seconds", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green" }, { "color": "yellow", "value": 86400 }, { "color": "red", "value": 90000 }] } } }
    },
    {
      "type": "timeseries",
      "title": "Host CPU %",
      "id": 20,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
        "legendFormat": "cpu %",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } }
    },
    {
      "type": "timeseries",
      "title": "Host RAM (dostępna %)",
      "id": 21,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "expr": "100 * node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes",
        "legendFormat": "avail %",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } }
    },
    {
      "type": "timeseries",
      "title": "Dysk wolny (/)",
      "id": 22,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "expr": "100 * node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"rootfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"rootfs\"}",
        "legendFormat": "free %",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } }
    },
    {
      "type": "timeseries",
      "title": "RAM kontenerów Docker",
      "id": 23,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "expr": "sum by (name) (container_memory_working_set_bytes{name=~\"verris-.*\", name!=\"\"})",
        "legendFormat": "{{name}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "type": "timeseries",
      "title": "API HTTP — RPS",
      "id": 30,
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 24 },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "sum(rate(verris_http_requests_total[5m]))", "legendFormat": "req/s", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "type": "timeseries",
      "title": "API HTTP — p95",
      "id": 31,
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 24 },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "expr": "histogram_quantile(0.95, sum(rate(verris_http_request_duration_seconds_bucket[5m])) by (le))",
        "legendFormat": "p95",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries",
      "title": "API HTTP — udział 5xx",
      "id": 32,
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 24 },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "expr": "sum(rate(verris_http_requests_total{status_class=\"5xx\"}[5m])) / clamp_min(sum(rate(verris_http_requests_total[5m])), 0.001)",
        "legendFormat": "5xx ratio",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1 } }
    },
    {
      "type": "stat",
      "title": "Postgres connections",
      "id": 40,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 31 },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "pg_stat_activity_count", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Redis memory",
      "id": 41,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 31 },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "redis_memory_used_bytes", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "type": "stat",
      "title": "Węzły ACTIVE",
      "id": 42,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 31 },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "verris_servers_total{status=\"ACTIVE\"}", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Incidents OPEN",
      "id": 43,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 31 },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "sum(verris_incidents_open)", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green" }, { "color": "red", "value": 1 }] } } }
    },
    {
      "type": "table",
      "title": "Subskrypcje per status",
      "id": 50,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "verris_subscriptions_total", "format": "table", "instant": true, "refId": "A" }],
      "transformations": [{ "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true, "service": true }, "renameByName": { "status": "Status", "Value": "Liczba" } } }]
    },
    {
      "type": "table",
      "title": "Tickety per status",
      "id": 51,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "verris_tickets_total", "format": "table", "instant": true, "refId": "A" }],
      "transformations": [{ "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true, "service": true }, "renameByName": { "status": "Status", "Value": "Liczba" } } }]
    }
  ],
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["verris", "overview"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "Ops overview",
  "uid": "verris-ops-overview",
  "version": 1
}
