{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 0,
  "panels": [
    {
      "type": "stat",
      "title": "API uptime",
      "id": 1,
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "verris_process_uptime_seconds", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "options": { "graphMode": "area", "colorMode": "value" }
    },
    {
      "type": "stat",
      "title": "API memory (RSS)",
      "id": 2,
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "verris_process_memory_bytes{kind=\"rss\"}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "type": "stat",
      "title": "Subscriptions: ACTIVE",
      "id": 3,
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "verris_subscriptions_total{status=\"ACTIVE\"}", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "Subscriptions: PAST_DUE / SUSPENDED",
      "id": 4,
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "sum(verris_subscriptions_total{status=~\"PAST_DUE|SUSPENDED\"})", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green" }, { "color": "red", "value": 1 }] } } }
    },
    {
      "type": "timeseries",
      "title": "Subscriptions over time (per status)",
      "id": 5,
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 5 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "verris_subscriptions_total", "legendFormat": "{{status}}", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "Provisioning queue depth",
      "id": 10,
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 14 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "sum(verris_provisioning_queue_depth{state=~\"active|waiting|delayed\"})", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green" }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 25 }] } } }
    },
    {
      "type": "stat",
      "title": "Provisioning failed (last)",
      "id": 11,
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 14 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "verris_provisioning_queue_depth{state=\"failed\"}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green" }, { "color": "red", "value": 1 }] } } }
    },
    {
      "type": "timeseries",
      "title": "Provisioning by stage (klient widoczny)",
      "id": 12,
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 14 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "verris_provisioning_stage_total", "legendFormat": "{{stage}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Provisioning jobs throughput",
      "id": 13,
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 23 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "increase(verris_provisioning_jobs_total[5m])", "legendFormat": "{{event}}", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "Postgres backup (MinIO) — wiek",
      "id": 20,
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 32 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "verris_backup_latest_age_seconds", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 },
              { "color": "yellow", "value": 86400 },
              { "color": "red", "value": 90000 }
            ]
          }
        }
      },
      "options": { "colorMode": "value" }
    },
    {
      "type": "stat",
      "title": "Postgres backup — rozmiar",
      "id": 21,
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 32 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "verris_backup_latest_size_bytes", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "type": "stat",
      "title": "Backup obecny w MinIO",
      "id": 22,
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 32 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "verris_backup_present", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "BRAK", "color": "red" }, "1": { "text": "OK", "color": "green" } } }
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Migracje FAILED",
      "id": 23,
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 32 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "verris_migration_worker_jobs_failed", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green" }, { "color": "red", "value": 1 }] }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "API HTTP — udział 5xx (5m)",
      "id": 30,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 37 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(verris_http_requests_total{status_class=\"5xx\"}[5m])) / clamp_min(sum(rate(verris_http_requests_total[5m])), 0.001)",
          "legendFormat": "5xx ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green" }, { "color": "yellow", "value": 0.005 }, { "color": "red", "value": 0.01 }] }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "API HTTP — latency p95 (5m)",
      "id": 31,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 37 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(verris_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green" }, { "color": "yellow", "value": 0.5 }, { "color": "red", "value": 2 }] } } }
    },
    {
      "type": "timeseries",
      "title": "API HTTP — RPS (5m)",
      "id": 32,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 45 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(verris_http_requests_total[5m]))",
          "legendFormat": "req/s",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    }
  ],
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["verris", "control-plane"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "title": "Control plane health",
  "uid": "verris-control-plane",
  "version": 1
}
