{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 0,
  "panels": [
    {
      "type": "text",
      "title": "Storage & backupy",
      "id": 1,
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "Pliki aplikacji i backupy Postgres są w **MinIO** (`verris-backups/postgres/`). Zewnętrzny mirror: `ops/backup-mirror-external.sh`."
      }
    },
    {
      "type": "stat",
      "title": "Wiek ostatniego backupu DB",
      "id": 2,
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 3 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "verris_backup_latest_age_seconds", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 },
              { "color": "yellow", "value": 86400 },
              { "color": "red", "value": 90000 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Rozmiar latest.sql.gz",
      "id": 3,
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 3 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "verris_backup_latest_size_bytes", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "type": "stat",
      "title": "Status webhooków (FAILED)",
      "id": 4,
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 3 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "sum(verris_status_webhook_deliveries_total{status=\"FAILED\"})", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green" }, { "color": "red", "value": 1 }] }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Wiek backupu (trend)",
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "verris_backup_latest_age_seconds", "legendFormat": "age_seconds", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries",
      "title": "Kolejka provisioningu",
      "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "verris_provisioning_queue_depth", "legendFormat": "{{state}}", "refId": "A" }
      ]
    }
  ],
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["verris", "storage", "backup"],
  "templating": { "list": [] },
  "time": { "from": "now-24h", "to": "now" },
  "title": "Storage & backupy (MinIO)",
  "uid": "verris-ops-storage",
  "version": 1
}
