{
  "annotations": { "list": [] },
  "editable": false,
  "description": "Wydajność API / czasy reakcji — p95/p99, error rate, RPS, pamięć, błędy runtime. Źródło: histogram verris_http_request_duration_seconds + verris_http_requests_total + verris_process_* (Prometheus).",
  "panels": [
    { "type": "stat", "title": "RPS (1 min)", "id": 1, "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "sum(rate(verris_http_requests_total[1m]))", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 } } },
    { "type": "stat", "title": "p95 globalne", "id": 2, "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "histogram_quantile(0.95, sum(rate(verris_http_request_duration_seconds_bucket[5m])) by (le))", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green" }, { "color": "yellow", "value": 0.5 }, { "color": "red", "value": 1 } ] } } } },
    { "type": "stat", "title": "Udział 5xx (5 min)", "id": 3, "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "sum(rate(verris_http_requests_total{status_class=\"5xx\"}[5m])) / clamp_min(sum(rate(verris_http_requests_total[5m])), 1)", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 3, "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green" }, { "color": "red", "value": 0.01 } ] } } } },
    { "type": "stat", "title": "Uptime API", "id": 4, "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "verris_process_uptime_seconds", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "s" } } },
    { "type": "timeseries", "title": "p95 czasu odpowiedzi wg endpointu (top 10)", "id": 5, "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "topk(10, histogram_quantile(0.95, sum(rate(verris_http_request_duration_seconds_bucket[5m])) by (le, route)))", "legendFormat": "{{route}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "s" } } },
    { "type": "timeseries", "title": "Ruch wg klasy statusu", "id": 6, "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "sum(rate(verris_http_requests_total[5m])) by (status_class)", "legendFormat": "{{status_class}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "reqps" } } },
    { "type": "table", "title": "Najwolniejsze endpointy (p95, teraz)", "id": 7, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "topk(15, histogram_quantile(0.95, sum(rate(verris_http_request_duration_seconds_bucket[5m])) by (le, route, method)))", "format": "table", "instant": true, "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "s" } } },
    { "type": "timeseries", "title": "Pamięć procesu API", "id": 8, "gridPos": { "h": 8, "w": 6, "x": 12, "y": 13 },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "verris_process_memory_bytes", "legendFormat": "{{kind}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "bytes" } } },
    { "type": "timeseries", "title": "Błędy runtime (5 min)", "id": 9, "gridPos": { "h": 8, "w": 6, "x": 18, "y": 13 },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "sum(rate(verris_runtime_errors_total[5m]))", "legendFormat": "błędy/s", "refId": "A" } ] }
  ],
  "refresh": "30s", "schemaVersion": 36, "style": "dark", "tags": [ "verris", "api", "wydajnosc" ], "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" }, "title": "Wydajność API", "uid": "verris-api", "version": 1
}
