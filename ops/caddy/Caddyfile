    reverse_proxy ops-sogo-1:80
}

# -----------------------------------------------------------------------------
# KB-PUBLIC — publiczna Baza Wiedzy (pomoc.verris.pl). Anonimowo, indeksowalne.
# Kieruje na API z prefiksem /kb (kontroler KbPublicController: /kb, /kb/a/:slug,
# /kb/c/:slug, /kb/sitemap.xml, /kb/robots.txt).
# -----------------------------------------------------------------------------
{$CADDY_KB_DOMAIN:pomoc.verris.local} {
    import security_headers
    import block_scanners
    rewrite * /kb{uri}
    reverse_proxy api:3000 {
        health_uri /readyz
        health_interval 3s
        health_timeout 5s
        lb_try_duration 30s
        lb_try_interval 500ms
    }
    header Cache-Control "public, max-age=300"
}

# -----------------------------------------------------------------------------
# WWW — publiczna strona marketingowa verris.pl (Next.js + Payload, apps/www).
# CSP dopuszcza Google Fonts, GTM, Google Ads i Meta (tagi i tak odpalają się
# wyłącznie po zgodzie — Consent Mode v2). Panel Payload /admin jest login-gated;
# rozważ dodatkowe ograniczenie (VPN/rate-limit) jeśli ma być niepubliczny.
# -----------------------------------------------------------------------------
{$CADDY_WWW_DOMAIN:verris.local} {
    import security_headers
    import block_scanners
    header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://www.facebook.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https://*.googletagmanager.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://connect.facebook.net; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.doubleclick.net https://*.googlesyndication.com https://www.googleadservices.com https://www.google.com https://www.facebook.com https://connect.facebook.net; frame-src https://td.doubleclick.net https://www.googletagmanager.com https://www.facebook.com"
    reverse_proxy www:3005 {
        health_uri /healthz
        health_interval 3s
        health_timeout 5s
        lb_try_duration 30s
        lb_try_interval 500ms
    }
}

# www.verris.pl → apex (301).
{$CADDY_WWW_REDIRECT_DOMAIN:www.verris.local} {
    redir https://{$CADDY_WWW_DOMAIN:verris.local}{uri} permanent
}
