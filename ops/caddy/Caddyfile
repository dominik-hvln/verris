{
    # Replace with your administrator email so Let's Encrypt can email
    # certificate-related warnings.
    email admin@verris.pl
}

# -----------------------------------------------------------------------------
# Shared security headers (pre-LIVE hardening). HSTS only makes sense on the
# HTTPS production domains — Caddy serves HTTP only for local *.verris.local.
# `-Server` strips the server banner.
# -----------------------------------------------------------------------------
(security_headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        # 2026-09-28: www, API, status i Grafana nie wysyłały Permissions-Policy (panele tak).
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
        -X-Powered-By
    }
}

# Nagłówki paneli w jednym bloku header (osobne dyrektywy się nadpisują).
(panel_headers) {
    import security_headers
    header {
        # CSP paneli ustawia aplikacja (proxy/middleware Next) z nonce per żądanie, bez 'unsafe-inline'
        # w script-src — źródło: libs/ui/src/csp.ts (decyzja 09.10). Caddy NIE może dawać drugiego CSP:
        # przeglądarka stosuje oba nagłówki naraz (każdy zasób musi przejść obie polityki), więc stara polityka
        # bez nonce zablokowałaby skrypty Nexta, a z 'unsafe-inline' nic by nie wnosiła.
        # `?` = wartość domyślna, wpisywana tylko gdy upstream nie wysłał CSP (trasy poza matcherem proxy:
        # /api, /_next/static, pliki publiczne, strona błędu Caddy). Bez skryptów inline i bez obcych hostów.
        ?Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:"
        X-Frame-Options "DENY"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }
}

# Blok oczywistych skanerów/exploitów (control-plane to Next/Nest — brak PHP/WP/.git).
# Caddy wykonuje `respond` przed `reverse_proxy`, więc dopasowane ścieżki dostają 403,
# a reszta normalnie trafia do upstreamu.
(block_scanners) {
    @scanners path *.php /.env /.env.* /.git /.git/* /vendor/* /.aws/* /wp-login.php /wp-admin /wp-admin/* /xmlrpc.php /cgi-bin/* /.svn/* /.DS_Store
    respond @scanners 403
}

# CYBER-11 — responsible disclosure. RFC 9116 security.txt na /.well-known/.
# Zaktualizuj `Expires` co ~roku. Kanał: security@verris.pl.
(security_txt) {
    @securitytxt path /.well-known/security.txt /security.txt
    handle @securitytxt {
        header Content-Type "text/plain; charset=utf-8"
        respond `Contact: mailto:security@verris.pl
Expires: 2027-07-04T00:00:00.000Z
Preferred-Languages: pl, en
Canonical: https://panel.verris.pl/.well-known/security.txt
Policy: https://panel.verris.pl/legal/security
` 200
    }
}

# -----------------------------------------------------------------------------
# Public client panel
# -----------------------------------------------------------------------------
{$CADDY_CLIENT_DOMAIN:panel.verris.local} {
    import panel_headers
    import block_scanners
    import security_txt
    reverse_proxy client-panel:3001 {
        # STAB-1 — aktywny health-check zdejmuje upstream w trakcie restartu,
        # a szersze okno prób „przetrzymuje" żądanie aż nowy kontener wstanie.
        health_uri /api/health
        health_interval 3s
        # STAB-2 — 2s bywało zbyt agresywne: chwilowe obciążenie (np. seria
        # server-action POST w menedżerze plików) potrafiło przekroczyć 2s na
        # pojedynczym procesie Node, przez co Caddy zdejmował CAŁY upstream i
        # zwracał 503 na bieżące żądania. Realnie martwy kontener i tak odpada
        # natychmiast (connection refused), więc dłuższy timeout nie spowalnia
        # wykrywania restartu (STAB-1), a eliminuje fałszywe 503.
        health_timeout 5s
        lb_try_duration 30s
        lb_try_interval 500ms
    }
}

# -----------------------------------------------------------------------------
# Internal panels (staff/admin, GlitchTip) — tylko z VPN (ETAP 8, decyzja 09.10).
#
# CADDY_INTERNAL_ALLOW_CIDR = podsieć WireGuard (np. "10.88.0.0/24"), kilka
# zakresów po spacji. FAIL-CLOSED (do 09.10 było odwrotnie — puste = wszyscy):
#   - puste / nieustawione  → 403 dla wszystkich (na liście zostaje tylko
#     192.0.2.1 z TEST-NET-1, RFC 5737 — adres, z którego nic nie przychodzi),
#   - zakres /0–/7 (np. stary domyślny "0.0.0.0/0 ::/0", który nadal może
#     siedzieć w env działającego kontenera) → 403 dla wszystkich,
#   - zła składnia → Caddy odrzuca konfigurację: reload zostawia poprzednią,
#     a przy starcie kontenera ops/caddy/start.sh uruchamia go z pustą listą.
# remote_ip, nie client_ip: przed Caddy nie ma proxy (brak trusted_proxies);
# ruch z tunelu dochodzi z adresu 10.88.0.x (DNAT Dockera zachowuje źródło).
# Kolejność włączania i powrót awaryjny: DEPLOY.md → „VPN WireGuard…”.
# -----------------------------------------------------------------------------
(vpn_odmowa) {
    header {args[0]} Content-Type "text/html; charset=utf-8"
    header {args[0]} Cache-Control "no-store"
    respond {args[0]} `<!doctype html><html lang="pl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex"><title>Brak dostępu</title></head><body style="margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;font-family:system-ui,-apple-system,sans-serif;background:#f6f7f9;color:#1f2933"><main style="max-width:30rem;padding:2rem;text-align:center"><h1 style="font-size:1.4rem;margin:0 0 .75rem">Brak dostępu</h1><p style="margin:0 0 .5rem;line-height:1.5">Ten panel jest dostępny wyłącznie z sieci wewnętrznej zespołu.</p><p style="margin:0;line-height:1.5;color:#52606d">Jeśli pracujesz w zespole, połącz się z siecią firmową i odśwież stronę.</p></main></body></html>` 403
}

(vpn_only) {
    @spoza_vpn not remote_ip 192.0.2.1/32 {$CADDY_INTERNAL_ALLOW_CIDR}
    @vpn_lista_otwarta expression `'{$CADDY_INTERNAL_ALLOW_CIDR}'.matches('/[0-7]($|[^0-9])')`
    import vpn_odmowa @vpn_lista_otwarta
    import vpn_odmowa @spoza_vpn
}

{$CADDY_STAFF_DOMAIN:staff.verris.local} {
    import panel_headers
    import vpn_only
    import block_scanners
    reverse_proxy staff-panel:3002 {
        health_uri /api/health
        health_interval 3s
        # STAB-2 — 2s bywało zbyt agresywne: chwilowe obciążenie (np. seria
        # server-action POST w menedżerze plików) potrafiło przekroczyć 2s na
        # pojedynczym procesie Node, przez co Caddy zdejmował CAŁY upstream i
        # zwracał 503 na bieżące żądania. Realnie martwy kontener i tak odpada
        # natychmiast (connection refused), więc dłuższy timeout nie spowalnia
        # wykrywania restartu (STAB-1), a eliminuje fałszywe 503.
        health_timeout 5s
        lb_try_duration 30s
        lb_try_interval 500ms
    }
}

