{
    # Replace with your administrator email so Let's Encrypt can email
    # certificate-related warnings.
    email admin@verris.pl
}

# -----------------------------------------------------------------------------
# Public client panel
# -----------------------------------------------------------------------------
{$CADDY_CLIENT_DOMAIN:panel.verris.local} {
    reverse_proxy client-panel:3001
}

# -----------------------------------------------------------------------------
# Internal staff panel — restrict to office IPs in production!
# -----------------------------------------------------------------------------
{$CADDY_STAFF_DOMAIN:staff.verris.local} {
    reverse_proxy staff-panel:3002
}

# -----------------------------------------------------------------------------
# Admin / Core panel
# -----------------------------------------------------------------------------
{$CADDY_ADMIN_DOMAIN:admin.verris.local} {
    reverse_proxy admin-panel:3003
}

# -----------------------------------------------------------------------------
# Public API (also receives Stripe webhooks at /billing/stripe/webhook)
# -----------------------------------------------------------------------------
{$CADDY_API_DOMAIN:api.verris.local} {
    reverse_proxy api:3000
}

# -----------------------------------------------------------------------------
# Public status page (status.verris.pl) — anonymous, fed by GET /status.
# No auth required, fully cacheable for ~30 s at the edge.
# -----------------------------------------------------------------------------
{$CADDY_STATUS_DOMAIN:status.verris.local} {
    reverse_proxy status-page:3004
    header Cache-Control "public, max-age=30"
}

# -----------------------------------------------------------------------------
# Grafana (F-15) — every request is verified against our API via
# `forward_auth` BEFORE it reaches Grafana. The API endpoint reads either the
# `auth_token` cookie (panels) or `Authorization: Bearer` header, returns 401
# for unauthenticated, 403 for users without `canAccessGrafana=true`, and on
# success copies `X-WEBAUTH-USER` / `X-WEBAUTH-ROLE` onto the response.
# Grafana's `auth.proxy` mode picks them up and auto-creates the user.
# -----------------------------------------------------------------------------
{$CADDY_GRAFANA_DOMAIN:grafana.verris.local} {
    forward_auth api:3000 {
        uri /auth/grafana-validate
        copy_headers X-Webauth-User X-Webauth-Role
    }
    reverse_proxy grafana:3000
}

# -----------------------------------------------------------------------------
# SOGo webmail + CalDAV (host sogod on :20000, Dovecot/Postfix on host)
# -----------------------------------------------------------------------------
{$CADDY_MAIL_DOMAIN:mail.verris.local} {
    # SOGo container on verris_verris_public (ops/docker-compose.sogo-mail.yml).
    reverse_proxy ops-sogo-1:80
}
