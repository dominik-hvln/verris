{
    # Replace with your administrator email so Let's Encrypt can email
    # certificate-related warnings.
    email admin@verris.pl
}

# -----------------------------------------------------------------------------
# Shared security headers (pre-LIVE hardening). HSTS only makes sense on the
# HTTPS production domains — Caddy serves HTTP only for local *.verris.local.
# `-Server` strips the server banner.
# -----------------------------------------------------------------------------
(security_headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
        -X-Powered-By
    }
}

# CSP + nagłówki paneli w jednym bloku header (osobne dyrektywy się nadpisują).
(panel_headers) {
    import security_headers
    header {
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://js.stripe.com; connect-src 'self' https://api.verris.pl https://*.stripe.com; frame-src https://js.stripe.com https://hooks.stripe.com"
        X-Frame-Options "DENY"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }
}

# -----------------------------------------------------------------------------
# Public client panel
# -----------------------------------------------------------------------------
{$CADDY_CLIENT_DOMAIN:panel.verris.local} {
    import panel_headers
    reverse_proxy client-panel:3001
}

# -----------------------------------------------------------------------------
# Internal panels (staff/admin) — VPN-only access (ETAP 8).
#
# Set CADDY_INTERNAL_ALLOW_CIDR to the WireGuard subnet (e.g. "10.88.0.0/24")
# in .env.prod AFTER the VPN is up and your own peer works — the default
# allows everything so a fresh deploy can't lock the operator out.
# Multiple CIDRs: space-separated ("10.88.0.0/24 203.0.113.7/32").
# -----------------------------------------------------------------------------
(vpn_only) {
    @outside_vpn not remote_ip {$CADDY_INTERNAL_ALLOW_CIDR:0.0.0.0/0 ::/0}
    respond @outside_vpn "403 — dostęp do tego panelu wyłącznie przez VPN Verris." 403
}

{$CADDY_STAFF_DOMAIN:staff.verris.local} {
    import panel_headers
    import vpn_only
    reverse_proxy staff-panel:3002
}

# -----------------------------------------------------------------------------
# Admin / Core panel
# -----------------------------------------------------------------------------
{$CADDY_ADMIN_DOMAIN:admin.verris.local} {
    import panel_headers
    import vpn_only
    reverse_proxy admin-panel:3003
}

# -----------------------------------------------------------------------------
# Public API (also receives Stripe webhooks at /billing/stripe/webhook)
# -----------------------------------------------------------------------------
{$CADDY_API_DOMAIN:api.verris.local} {
    import security_headers
    # API zwraca JSON — niczego nie renderuje, więc najostrzejszy CSP.
    header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
    reverse_proxy api:3000
}

# -----------------------------------------------------------------------------
# Public status page (status.verris.pl) — anonymous, fed by GET /status.
# No auth required, fully cacheable for ~30 s at the edge.
# -----------------------------------------------------------------------------
{$CADDY_STATUS_DOMAIN:status.verris.local} {
    import security_headers
    reverse_proxy status-page:3004
    header Cache-Control "public, max-age=30"
}

# -----------------------------------------------------------------------------
# Grafana (F-15) — every request is verified against our API via
# `forward_auth` BEFORE it reaches Grafana. The API endpoint reads either the
# `auth_token` cookie (panels) or `Authorization: Bearer` header, returns 401
# for unauthenticated, 403 for users without `canAccessGrafana=true`, and on
# success copies `X-WEBAUTH-USER` / `X-WEBAUTH-ROLE` onto the response.
# Grafana's `auth.proxy` mode picks them up and auto-creates the user.
# -----------------------------------------------------------------------------
{$CADDY_GRAFANA_DOMAIN:grafana.verris.local} {
    import security_headers
    forward_auth api:3000 {
        uri /auth/grafana-validate
        copy_headers X-Webauth-User X-Webauth-Role
    }
    reverse_proxy grafana:3000
}

# -----------------------------------------------------------------------------
# SOGo webmail + CalDAV (host sogod on :20000, Dovecot/Postfix on host)
# -----------------------------------------------------------------------------
{$CADDY_MAIL_DOMAIN:mail.verris.local} {
    import security_headers
    reverse_proxy ops-sogo-1:80
}
