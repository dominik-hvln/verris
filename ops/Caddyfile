{
    # Replace with your administrator email so Let's Encrypt can email
    # certificate-related warnings.
    email admin@verris.pl
}

# -----------------------------------------------------------------------------
# Shared security headers (pre-LIVE hardening). HSTS only makes sense on the
# HTTPS production domains — Caddy serves HTTP only for local *.verris.local.
# `-Server` strips the server banner.
# -----------------------------------------------------------------------------
(security_headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
        -X-Powered-By
    }
}

# CSP + nagłówki paneli w jednym bloku header (osobne dyrektywy się nadpisują).
(panel_headers) {
    import security_headers
    header {
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://js.stripe.com; connect-src 'self' https://api.verris.pl https://*.stripe.com; frame-src https://js.stripe.com https://hooks.stripe.com"
        X-Frame-Options "DENY"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }
}

# Blok oczywistych skanerów/exploitów (control-plane to Next/Nest — brak PHP/WP/.git).
# Caddy wykonuje `respond` przed `reverse_proxy`, więc dopasowane ścieżki dostają 403,
# a reszta normalnie trafia do upstreamu.
(block_scanners) {
    @scanners path *.php /.env /.env.* /.git /.git/* /vendor/* /.aws/* /wp-login.php /wp-admin /wp-admin/* /xmlrpc.php /cgi-bin/* /.svn/* /.DS_Store
    respond @scanners 403
}

# -----------------------------------------------------------------------------
# Public client panel
# -----------------------------------------------------------------------------
{$CADDY_CLIENT_DOMAIN:panel.verris.local} {
    import panel_headers
    import block_scanners
    reverse_proxy client-panel:3001 {
        # STAB-1 — aktywny health-check zdejmuje upstream w trakcie restartu,
        # a szersze okno prób „przetrzymuje" żądanie aż nowy kontener wstanie.
        health_uri /api/health
        health_interval 3s
        # STAB-2 — 2s bywało zbyt agresywne: chwilowe obciążenie (np. seria
        # server-action POST w menedżerze plików) potrafiło przekroczyć 2s na
        # pojedynczym procesie Node, przez co Caddy zdejmował CAŁY upstream i
        # zwracał 503 na bieżące żądania. Realnie martwy kontener i tak odpada
        # natychmiast (connection refused), więc dłuższy timeout nie spowalnia
        # wykrywania restartu (STAB-1), a eliminuje fałszywe 503.
        health_timeout 5s
        lb_try_duration 30s
        lb_try_interval 500ms
    }
}

# -----------------------------------------------------------------------------
# Internal panels (staff/admin) — VPN-only access (ETAP 8).
#
# Set CADDY_INTERNAL_ALLOW_CIDR to the WireGuard subnet (e.g. "10.88.0.0/24")
# in .env.prod AFTER the VPN is up and your own peer works — the default
# allows everything so a fresh deploy can't lock the operator out.
# Multiple CIDRs: space-separated ("10.88.0.0/24 203.0.113.7/32").
# -----------------------------------------------------------------------------
(vpn_only) {
    @outside_vpn not remote_ip {$CADDY_INTERNAL_ALLOW_CIDR:0.0.0.0/0 ::/0}
    respond @outside_vpn "403 — dostęp do tego panelu wyłącznie przez VPN Verris." 403
}

{$CADDY_STAFF_DOMAIN:staff.verris.local} {
    import panel_headers
    import vpn_only
    import block_scanners
    reverse_proxy staff-panel:3002 {
        health_uri /api/health
        health_interval 3s
        # STAB-2 — 2s bywało zbyt agresywne: chwilowe obciążenie (np. seria
        # server-action POST w menedżerze plików) potrafiło przekroczyć 2s na
        # pojedynczym procesie Node, przez co Caddy zdejmował CAŁY upstream i
        # zwracał 503 na bieżące żądania. Realnie martwy kontener i tak odpada
        # natychmiast (connection refused), więc dłuższy timeout nie spowalnia
        # wykrywania restartu (STAB-1), a eliminuje fałszywe 503.
        health_timeout 5s
        lb_try_duration 30s
        lb_try_interval 500ms
    }
}

