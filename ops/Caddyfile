# -----------------------------------------------------------------------------
# Public API (also receives Stripe webhooks at /billing/stripe/webhook)
# -----------------------------------------------------------------------------
{$CADDY_API_DOMAIN:api.verris.local} {
    import security_headers
    import block_scanners
    # API zwraca JSON — niczego nie renderuje, więc najostrzejszy CSP.
    header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
    reverse_proxy api:3000 {
        # STAB-1 — health-check na /readyz (DB + flaga drain). Przy SIGTERM API
        # zwraca tu 503 → Caddy przestaje kierować ruch zanim kontener padnie.
        health_uri /readyz
        health_interval 3s
        # STAB-2 — 2s bywało zbyt agresywne: chwilowe obciążenie (np. seria
        # server-action POST w menedżerze plików) potrafiło przekroczyć 2s na
        # pojedynczym procesie Node, przez co Caddy zdejmował CAŁY upstream i
        # zwracał 503 na bieżące żądania. Realnie martwy kontener i tak odpada
        # natychmiast (connection refused), więc dłuższy timeout nie spowalnia
        # wykrywania restartu (STAB-1), a eliminuje fałszywe 503.
        health_timeout 5s
        lb_try_duration 30s
        lb_try_interval 500ms
    }
}

# -----------------------------------------------------------------------------
# Public status page (status.verris.pl) — anonymous, fed by GET /status.
# No auth required, fully cacheable for ~30 s at the edge.
# -----------------------------------------------------------------------------
{$CADDY_STATUS_DOMAIN:status.verris.local} {
    import security_headers
    import block_scanners
    reverse_proxy status-page:3004 {
        health_uri /api/health
        health_interval 3s
        # STAB-2 — 2s bywało zbyt agresywne: chwilowe obciążenie (np. seria
        # server-action POST w menedżerze plików) potrafiło przekroczyć 2s na
        # pojedynczym procesie Node, przez co Caddy zdejmował CAŁY upstream i
        # zwracał 503 na bieżące żądania. Realnie martwy kontener i tak odpada
        # natychmiast (connection refused), więc dłuższy timeout nie spowalnia
        # wykrywania restartu (STAB-1), a eliminuje fałszywe 503.
        health_timeout 5s
        lb_try_duration 30s
        lb_try_interval 500ms
    }
    header Cache-Control "public, max-age=30"
}

# -----------------------------------------------------------------------------
# Grafana (F-15) — every request is verified against our API via
# `forward_auth` BEFORE it reaches Grafana. The API endpoint reads either the
# `auth_token` cookie (panels) or `Authorization: Bearer` header, returns 401
# for unauthenticated, 403 for users without `canAccessGrafana=true`, and on
# success copies `X-WEBAUTH-USER` / `X-WEBAUTH-ROLE` onto the response.
# Grafana's `auth.proxy` mode picks them up and auto-creates the user.
# -----------------------------------------------------------------------------
{$CADDY_GRAFANA_DOMAIN:grafana.verris.local} {
    import security_headers
    forward_auth api:3000 {
        uri /auth/grafana-validate
        copy_headers X-Webauth-User X-Webauth-Role
    }
    reverse_proxy grafana:3000
}

# -----------------------------------------------------------------------------
# SOGo webmail + CalDAV (host sogod on :20000, Dovecot/Postfix on host)
# -----------------------------------------------------------------------------
{$CADDY_MAIL_DOMAIN:mail.verris.local} {
    import security_headers
    reverse_proxy ops-sogo-1:80
}

# -----------------------------------------------------------------------------
# KB-PUBLIC — publiczna Baza Wiedzy (pomoc.verris.pl). Anonimowo, indeksowalne.
# Kieruje na API z prefiksem /kb (kontroler KbPublicController: /kb, /kb/a/:slug,
# /kb/c/:slug, /kb/sitemap.xml, /kb/robots.txt).
# -----------------------------------------------------------------------------
{$CADDY_KB_DOMAIN:pomoc.verris.local} {
    import security_headers
    import block_scanners
    rewrite * /kb{uri}
    reverse_proxy api:3000 {
        health_uri /readyz
        health_interval 3s
        health_timeout 5s
        lb_try_duration 30s
        lb_try_interval 500ms
    }
    header Cache-Control "public, max-age=300"
}
