{
  "name": "verris",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:generate": "pnpm --filter @verris/database run db:generate",
    "db:migrate": "pnpm --filter @verris/database run db:migrate:deploy",
    "db:seed": "pnpm --filter @verris/database run db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.11",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.67.0"
  },
  "packageManager": "pnpm@9.5.0",
  "engines": {
    "node": ">=22.12"
  },
  "pnpm": {
    "overrides": {
      "@xhmikosr/decompress": "^11.1.3",
      "piscina": "^4.9.3",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@2": "^2.1.2",
      "fast-uri": "^3.1.4",
      "lodash": "^4.18.1",
      "nanoid@3": "^3.3.18",
      "postcss": "^8.5.26",
      "js-yaml@4": "^4.3.1",
      "form-data": "^4.0.6",
      "qs": "^6.15.3",
      "undici": "^7.29.0",
      "follow-redirects": "^1.16.0",
      "dompurify": "^3.4.7",
      "typescript": "^5.9.3",
      "esbuild": "^0.25.0",
      "body-parser": "^2.3.0",
      "@prisma/client": "6.19.3"
    }
  }
}
