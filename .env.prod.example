# =============================================================================
# Verris production environment — copy to .env.prod and fill in real values.
# Used by docker-compose.prod.yml.
# =============================================================================

# --- Domains ----------------------------------------------------------------
CLIENT_PANEL_URL=https://panel.verris.pl
STAFF_PANEL_URL=https://staff.verris.pl
ADMIN_PANEL_URL=https://admin.verris.pl
PUBLIC_API_URL=https://api.verris.pl
PUBLIC_STATUS_URL=https://status.verris.pl

# Klucz publiczny SSH control-plane → węzły compute (bootstrap + wildcard TLS deploy).
# Ten sam co /root/.ssh/verris_node_deploy.pub na serwerze panelu.
# VERRIS_NODE_DEPLOY_SSH_PUBKEY=ssh-ed25519 AAAA... cursor-agent-deploy@verris-prod

# Wewnętrzny URL Nest API dla server actions / SSR (Next w Dockerze — host `api`).
# W docker-compose.prod.yml jest już nadpisywane; wpisz tu to samo co w compose przy ręcznym deployu.
API_URL=http://api:3000

# --- Opcjonalnie przy seedzie: osobne hasło dla staff@verris.pl ---
# SEED_STAFF_PASSWORD=

CADDY_CLIENT_DOMAIN=panel.verris.pl
CADDY_STAFF_DOMAIN=staff.verris.pl
CADDY_ADMIN_DOMAIN=admin.verris.pl
CADDY_API_DOMAIN=api.verris.pl
CADDY_STATUS_DOMAIN=status.verris.pl
CADDY_GRAFANA_DOMAIN=grafana.verris.pl
CADDY_MAIL_DOMAIN=mail.verris.pl
CADDY_KB_DOMAIN=pomoc.verris.pl

# Cookie JWT na subdomenach (SSO Grafana: admin/staff → grafana.verris.pl).
# Lokalnie zostaw puste — host-only per panel.
AUTH_COOKIE_DOMAIN=.verris.pl

# --- Postgres ---------------------------------------------------------------
# POSTGRES_PASSWORD is used by the postgres container AND by the API (via entrypoint).
# You do NOT need to hand-build DATABASE_URL unless you prefer — leave it empty and
# the API image encodes the password correctly (openssl rand -base64 32 is fine).
POSTGRES_USER=verris
POSTGRES_PASSWORD=__GENERATE_A_LONG_RANDOM_PASSWORD__
POSTGRES_DB=verris_db
# DATABASE_URL=

# --- App secrets (regenerate per environment!) ------------------------------
# openssl rand -base64 48
JWT_SECRET=__REPLACE_ME_AT_LEAST_32_RANDOM_BYTES__
JWT_EXPIRES_IN=1d
APP_KMS_KEY=__REPLACE_ME_AT_LEAST_32_RANDOM_BYTES__

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Pin Stripe API + webhook payload shape (Dahlia). Must match Stripe Dashboard default version.
STRIPE_API_VERSION=2026-04-22.dahlia
STRIPE_SUCCESS_URL=https://panel.verris.pl/dashboard/billing?status=success
STRIPE_CANCEL_URL=https://panel.verris.pl/dashboard/billing?status=cancel

# --- Observability (F-12 → F-16) -------------------------------------------
# Bearer token Prometheus uses to scrape /metrics. Leave empty to allow
# unauthenticated scrapes (only safe when Prometheus runs on the same private
# Docker network and Caddy doesn't expose /metrics publicly — recommended).
METRICS_AUTH_TOKEN=

# Grafana admin (used only for break-glass; everyday access goes through SSO).
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=__GENERATE_A_LONG_RANDOM_PASSWORD__

# Read-only Postgres password for Grafana data-source. Set this AFTER the
# first migrate-deploy (which creates the role with a placeholder password):
#   docker compose ... exec postgres psql -U verris -d verris_db \
#     -c "ALTER USER grafana_ro PASSWORD '<here>';"
GRAFANA_DB_RO_PASSWORD=__GENERATE_A_LONG_RANDOM_PASSWORD__

# --- Redis (shared: rate-limits / queues; `REDIS_URL` is read by the API for
# C-9 wallet auto-top-up worker and future BullMQ provisioning). Must match
# the `redis` Docker service hostname on the internal network.
REDIS_URL=redis://redis:6379

# --- Ticket uploads (E-4): absolute path inside the API container for attachment
# files. Persist with a Docker volume/bind mount mapped to this path; default in
# code is `./uploads/tickets` under `cwd` when unset (ephemeral unless you volume it).
# TICKET_UPLOAD_DIR=/data/ticket-uploads

# --- Security (E-8) — jeśli ustawione, burst failed logins wysyła też e-mail
SECURITY_ALERT_EMAIL=

# --- Mail (E-3) — skonfiguruj aby `MailerService` wysyłał prawdziwe maile
# Outbound mail — Postfix on control-plane (default LIVE)
#
# API container hands off to Postfix on the host via localhost:25 (no AUTH).
# Install: docs/ops/POSTFIX_PANEL_RELAY.md
#
# Optional: override in admin → Ustawienia → Poczta (external relay stored in DB).
# API container → Postfix on the host (see docs/ops/POSTFIX_PANEL_RELAY.md)
SMTP_HOST=host.docker.internal
SMTP_PORT=25
SMTP_SECURE=none
# SMTP_USER=   # not used for local Postfix
# SMTP_PASS=
# Widoczne u klienta jako "Verris" <panel@verris.pl> — edytowalne w admin: Ustawienia → Poczta
SMTP_FROM_ADDRESS=panel@verris.pl
SMTP_FROM_NAME=Verris
# Outbound identity (deliverability — never use host.docker.internal in HELO/Message-ID)
SMTP_HELO_NAME=mail.verris.pl
SMTP_MESSAGE_ID_DOMAIN=verris.pl

# MAIL-4 — skrzynki zespołu (SOGo + IMAP); deploy: docs/ops/SOGO_MAIL_DEPLOY.md
CONTROL_PLANE_MAIL_MAPS_DIR=/etc/postfix/verris
CONTROL_PLANE_MAIL_DATA_ROOT=/var/mail/vhosts
CONTROL_PLANE_MAIL_HOST=mail.verris.pl
SOGO_WEB_URL=https://mail.verris.pl/SOGo
# Ten sam SOGO_DB_PASSWORD co w ops/sogo/.env.sogo (sync haseł webmail SOGo)
# Hostname kontenera MariaDB SOGo w sieci verris_internal (np. ops-sogo-db-1)
SOGO_MYSQL_HOST=ops-sogo-db-1
SOGO_MYSQL_PASSWORD=

# --- Domain registrar (OpenProvider reseller, white-label) --------------------
# Pozostaw REGISTRAR_PROVIDER puste, aby rejestracja domen była wyłączona (fail-closed).
REGISTRAR_PROVIDER=openprovider
OPENPROVIDER_API_BASE_URL=https://api.openprovider.eu
OPENPROVIDER_USERNAME=
OPENPROVIDER_PASSWORD=
# Uchwyt właściciela (reseller contact) — domeny rejestrujemy pod kontem Verris.
OPENPROVIDER_OWNER_HANDLE=
# Mnożnik marży na cenę hurtową po przeliczeniu na PLN (1.30 = +30%).
DOMAIN_PRICE_MARKUP=1.30
# Stawka VAT % — ceny OpenProvider są netto; klient płaci brutto z portfela.
DOMAIN_VAT_RATE=23
# FX hurt → PLN: domyślnie tabela A NBP (api.nbp.pl), fallback gdy NBP niedostępne.
DOMAIN_FX_NBP_ENABLED=true
DOMAIN_FX_NBP_MAX_AGE_MS=14400000
DOMAIN_FX_USD_PLN=3.65
DOMAIN_FX_EUR_PLN=4.32
# Alternatywny generyczny adapter HTTP (gdy REGISTRAR_PROVIDER != openprovider):
# REGISTRAR_API_BASE_URL=
# REGISTRAR_API_TOKEN=

# --- Platformowe serwery nazw (NS) dla kont hostingowych ----------------------
# Domyślne NS używane, gdy węzeł nie ma własnych (Server.ns1/ns2/ns3).
# Na start: NS od OVH dla jednego węzła; docelowo ns1/ns2/ns3.verris.pl (PowerDNS).
HOSTING_NS1=
HOSTING_NS2=
HOSTING_NS3=

# --- Automat NS w OVH (glue + strefa) -----------------------------------------
# Te same klucze co automat wildcard-TLS (ops/docs/OVH_WILDCARD_TLS_SETUP.md).
# Gdy ustawione, panel po akceptacji węzła automatycznie tworzy rekordy A/AAAA +
# glue dla markowych NS węzła i przypisuje je do węzła. Pozostaw puste → automat
# wyłączony (NS ustawiasz ręcznie).
OVH_ENDPOINT=ovh-eu
OVH_APP_KEY=
OVH_APP_SECRET=
OVH_CONSUMER_KEY=
# Domena bazowa, w której zakładane są glue/strefa dla NS (np. ns1.<węzeł>.verris.pl).
HOSTING_NS_BASE_DOMAIN=verris.pl
# NS per node: sequential (ns1+ns2, ns3+ns4…) or block100 (ns100+ns101, …)
HOSTING_NS_NUMBERING=sequential

# --- AI (asystent hostingu, prognozy, baza wiedzy RAG) ------------------------
# Endpoint zgodny z OpenAI (/chat/completions + /embeddings). Pozostaw AI_API_KEY
# puste, aby wyłączyć funkcje AI (panel pokazuje wtedy fallback, nie błąd).
AI_PROVIDER=openai-compatible
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Model embeddingów dla bazy wiedzy (RAG). Gdy niedostępny, wyszukiwanie działa
# na słowach kluczowych. Ustaw AI_EMBED_DISABLED=true aby wymusić tryb słów kluczowych.
AI_EMBED_MODEL=text-embedding-3-small
AI_EMBED_DISABLED=false

# Grafana alert e-mails (OPS-3) — host MUST include :port (unlike API SMTP_HOST + SMTP_PORT)
GRAFANA_SMTP_HOST=host.docker.internal:25
GRAFANA_ALERT_FROM_ADDRESS=panel@verris.pl
GRAFANA_ALERT_FROM_NAME=Verris Alerts

# --- Compute node bootstrap (NOT read by docker-compose on control-plane) -----
# Export these on each **compute node** as root before running the admin-generated
# bootstrap script. Documented in DEPLOY.md → „Węzły obliczeniowe”.
# LITESPEED_SERIAL_NO=                       # LiteSpeed license serial; required if LSWS is not pre-installed
# LSWS_WEBADMIN_ALLOW_IP=203.0.113.5         # Optional; IP/CIDR allowed in LSWS WebAdmin <allow> (port 7080)
# PUBLIC_IP=                                 # Optional; defaults to auto-detect if unset

# --- Pre-LIVE hardening (audyt 2026-06-09) ---
# Wymusza 2FA (TOTP) przy logowaniu kont ADMIN/STAFF. Włącz (=1) dopiero PO
# skonfigurowaniu TOTP na obu kontach seedowych — inaczej zablokujesz sobie
# możliwość enrollmentu.
REQUIRE_2FA_FOR_STAFF=1

# --- S-4b: sprawdzanie haseł w bazie wycieków (Have I Been Pwned) ---
# k-anonimowość: wysyłamy tylko 5 znaków SHA-1 hasła; pełne hasło nie opuszcza serwera.
# Fail-open (awaria HIBP nie blokuje rejestracji). Wyłącz: HIBP_ENABLED=0.
HIBP_ENABLED=1

# --- VPN WireGuard dla paneli wewnętrznych (ETAP 8) ---
# 1) Na hoście: bash ops/scripts/vpn-wireguard-setup.sh  (wypisze wartości)
# 2) Uzupełnij poniższe, zrestartuj api
# 3) bash ops/scripts/vpn-sync-peers.sh --install  (timer synchronizacji peerów)
# 4) Wygeneruj SWÓJ profil w panelu admin (/vpn), połącz się i sprawdź dostęp
# 5) DOPIERO WTEDY włącz restrykcję paneli: CADDY_INTERNAL_ALLOW_CIDR=10.88.0.0/24
VPN_WG_SERVER_PUBLIC_KEY=
VPN_WG_ENDPOINT=
# Token dla hostowego timera synchronizacji (X-Vpn-Sync-Token)
VPN_SYNC_TOKEN=
# Subnet VPN (domyślnie 10.88.0.0/24)
# VPN_WG_SUBNET=10.88.0.0/24
# Co klient kieruje w tunel — MUSI zawierać publiczny IP control-plane,
# żeby ruch do admin./staff. szedł przez VPN:
# VPN_WG_CLIENT_ALLOWED_IPS=10.88.0.0/24,<public-ip>/32
# Restrykcja Caddy (puste = brak restrykcji; ustaw po weryfikacji VPN!):
# CADDY_INTERNAL_ALLOW_CIDR=10.88.0.0/24

# --- C2: Passkeys / WebAuthn ---
# RP ID to domena rejestrowalna współdzielona przez panele (NIE URL):
WEBAUTHN_RP_ID=verris.pl
WEBAUTHN_RP_NAME=Verris
# Lista dozwolonych origin (panele) po przecinku:
WEBAUTHN_ORIGINS=https://panel.verris.pl,https://admin.verris.pl,https://staff.verris.pl

# --- CYBER-2: Anty-bot (pluggable CaptchaProvider) na rejestracji/logowaniu ---
# Dostawca: recaptcha (reCAPTCHA v2 checkbox, DOMYŚLNY) | recaptcha-v3 | hcaptcha | turnstile.
# Gdy jeden dostawca zawodzi (np. awarie Turnstile), przełączasz TU bez zmian w kodzie.
CAPTCHA_PROVIDER=recaptcha
# Secret (API) — backend weryfikuje token. Puste = ochrona WYŁĄCZONA (nie na prod!).
#   reCAPTCHA: https://www.google.com/recaptcha/admin   hCaptcha: https://dashboard.hcaptcha.com
CAPTCHA_SECRET_KEY=
# Wymuś włączenie/wyłączenie niezależnie od obecności sekretu (1/0). Puste = auto.
CAPTCHA_ENABLED=1
# Tylko recaptcha-v3: minimalny score (0..1), poniżej którego odrzucamy (domyślnie 0.5).
CAPTCHA_SCORE_THRESHOLD=0.5
# Klucze publiczne wstrzykiwane do paneli Next (build-time). Muszą zgadzać się z dostawcą.
NEXT_PUBLIC_CAPTCHA_PROVIDER=recaptcha
NEXT_PUBLIC_CAPTCHA_SITE_KEY=

# --- CYBER-9 / OBS-1: Monitoring błędów runtime (GlitchTip = Sentry self-hosted) ---
# 1) Uruchom GlitchTip:  docker compose -f docker-compose.prod.yml --profile glitchtip up -d
# 2) Wejdź na https://glitchtip.verris.pl (VPN), załóż konto, org i projekt.
# 3) Skopiuj DSN projektu tutaj — API zacznie wysyłać błędy 5xx.
CADDY_GLITCHTIP_DOMAIN=glitchtip.verris.pl
GLITCHTIP_SECRET_KEY=__GENERATE_AT_LEAST_50_RANDOM_CHARS__
GLITCHTIP_FROM_EMAIL=glitchtip@verris.pl
# Wysyłka maili GlitchTip przez hostowy Postfix (jak reszta): smtp://host.docker.internal:25
GLITCHTIP_EMAIL_URL=smtp://host.docker.internal:25
# DSN projektu (z UI GlitchTip). Puste = błędy tylko lokalnie (ring buffer + /metrics).
#   Wewnątrz sieci Docker host to glitchtip-web:8080.
SENTRY_DSN=
# Widok błędów w panelu: GET /admin/observability/errors (ADMIN/STAFF) + metryka
# verris_runtime_errors_total w Grafanie.

# --- CYBER-3: Ochrona przed outbound-spam (limity wysyłki per konto + cordon) ---
# Limity kontrolowanej wysyłki (EMM) per konto. Przekroczenie → auto-cordon + alert.
OUTBOUND_MAX_PER_MINUTE=200
OUTBOUND_MAX_PER_HOUR=1000
OUTBOUND_MAX_PER_DAY=5000
# Jak długo utrzymywać cordon (sekundy) — domyślnie 30 dni.
OUTBOUND_CORDON_TTL_SEC=2592000
# Alerty cordonu idą na SECURITY_ALERT_EMAIL (ustaw poniżej/wyżej).
# Na węźle: ops/scripts/node-outbound-throttle.sh --install (limity Postfix + cordon nadawcy).

# --- Backup Postgres → MinIO (S3) + szyfrowanie at-rest (S-2) ---
MINIO_ROOT_USER=verris
MINIO_ROOT_PASSWORD=__GENERATE_A_LONG_RANDOM_PASSWORD__
S3_BUCKET_BACKUPS=verris-backups
RETENTION_DAYS=14
# Szyfrowanie dumpów przed wysyłką (RODO art. 32). 1 = OBOWIĄZKOWE (fail-closed).
BACKUP_ENCRYPTION_ENABLED=1
# Klucze PUBLICZNE age odbiorców (klucz prywatny trzymaj OFFLINE!). Wygeneruj:
#   age-keygen -o verris-backup.key   # -> pokazuje "Public key: age1..."
# Zalecane 2 klucze: operacyjny + offline break-glass (spacja/przecinek):
BACKUP_AGE_RECIPIENTS=
# Alternatywnie plik z kluczami publicznymi (po jednym w linii):
# BACKUP_AGE_RECIPIENTS_FILE=/opt/verris/secrets/age-recipients.txt
# Klucz PRYWATNY age — TYLKO na maszynie do restore/drilla, NIE na prod control-plane:
# BACKUP_AGE_IDENTITY_FILE=/opt/verris/secrets/verris-backup.key

# --- Backup off-site (niezależny DC) + WORM przeciw ransomware (CYBER-8) ---
MIRROR_EXTERNAL_ENABLED=0
# OFFSITE_MC_ALIAS_URL=https://s3.eu-central-1.backup-provider.com
# OFFSITE_MC_ACCESS_KEY=
# OFFSITE_MC_SECRET_KEY=
# OFFSITE_MC_BUCKET=verris-backups-offsite
# Niezmienialność kopii off-site (wymaga storage z Object Lock, bucket --with-lock):
OFFSITE_WORM_ENABLED=1
OFFSITE_WORM_MODE=compliance
OFFSITE_WORM_DAYS=30

# --- Dane firmy / wystawcy faktur (HVLN) — sprzedawca na fakturach + KSeF ---
# Nadpisywalne w panelu admina (Ustawienia → Firma); env to fallback/seed.
VERRIS_COMPANY_NAME=HVLN Dominik Kowalski
VERRIS_COMPANY_NIP=9292069367
VERRIS_COMPANY_REGON=521024260
VERRIS_COMPANY_KRS=
VERRIS_COMPANY_ADDRESS=Zacisze 2A
VERRIS_COMPANY_CITY=Zielona Góra
VERRIS_COMPANY_POSTAL=65-775
VERRIS_COMPANY_COUNTRY=PL
VERRIS_COMPANY_EMAIL=kontakt@hvln.pl
VERRIS_COMPANY_BANK_ACCOUNT=

# --- B-1: KSeF (Krajowy System e-Faktur) — API v2 / FA(3) ---
# Włącz dopiero po smoke na środowisku testowym (ops/scripts/ksef-smoke.ts).
KSEF_ENABLED=0
# Wersja integracji: v2 (obowiązkowy KSeF 2.0/FA(3) od 2026) lub legacy v1 (FA(2) — @deprecated).
KSEF_API_VERSION=v2
# Środowisko: test | demo | prod (mapuje na api-test/api-demo/api .ksef.mf.gov.pl, ścieżka /api/v2).
KSEF_ENV=test
# NIP kontekstu (operatora) — dane HVLN uzupełniane też w billing/legal (9292069367).
KSEF_NIP=9292069367
# Token KSeF wygenerowany w Aplikacji Podatnika KSeF (uprawnienie: wystawianie faktur).
# Wygasa 31.12.2026 → docelowo certyfikat KSeF. Szyfrowany at-rest (KMS) po zapisie w panelu.
KSEF_TOKEN=
# FA(3) target namespace — POTWIERDŹ z opublikowanym XSD (CRWDE 25.06.2025) i zweryfikuj
# wygenerowany XML walidatorem na api-test PRZED LIVE (ops/scripts/ksef-smoke.ts).
KSEF_FA3_TARGET_NAMESPACE=http://crd.gov.pl/wzor/2025/06/25/13775/
# (opcjonalnie) ręczne nadpisanie base URL API KSeF (inaczej wyliczane z KSEF_ENV+wersji).
# KSEF_BASE_URL=
# (opcjonalnie, tylko legacy v1/FA(2)) klucz publiczny MF w PEM base64 — v2 pobiera klucze z API.
KSEF_PUBLIC_KEY_PEM_B64=
