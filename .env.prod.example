# =============================================================================
# Verris production environment — copy to .env.prod and fill in real values.
# Used by docker-compose.prod.yml.
# =============================================================================

# --- Domains ----------------------------------------------------------------
CLIENT_PANEL_URL=https://panel.verris.pl
STAFF_PANEL_URL=https://staff.verris.pl
ADMIN_PANEL_URL=https://admin.verris.pl
PUBLIC_API_URL=https://api.verris.pl
PUBLIC_STATUS_URL=https://status.verris.pl

# Wewnętrzny URL Nest API dla server actions / SSR (Next w Dockerze — host `api`).
# W docker-compose.prod.yml jest już nadpisywane; wpisz tu to samo co w compose przy ręcznym deployu.
API_URL=http://api:3000

# --- Opcjonalnie przy seedzie: osobne hasło dla staff@verris.pl ---
# SEED_STAFF_PASSWORD=

CADDY_CLIENT_DOMAIN=panel.verris.pl
CADDY_STAFF_DOMAIN=staff.verris.pl
CADDY_ADMIN_DOMAIN=admin.verris.pl
CADDY_API_DOMAIN=api.verris.pl
CADDY_STATUS_DOMAIN=status.verris.pl
CADDY_GRAFANA_DOMAIN=grafana.verris.pl

# Cookie JWT na subdomenach (SSO Grafana: admin/staff → grafana.verris.pl).
# Lokalnie zostaw puste — host-only per panel.
AUTH_COOKIE_DOMAIN=.verris.pl

# --- Postgres ---------------------------------------------------------------
# POSTGRES_PASSWORD is used by the postgres container AND by the API (via entrypoint).
# You do NOT need to hand-build DATABASE_URL unless you prefer — leave it empty and
# the API image encodes the password correctly (openssl rand -base64 32 is fine).
POSTGRES_USER=verris
POSTGRES_PASSWORD=__GENERATE_A_LONG_RANDOM_PASSWORD__
POSTGRES_DB=verris_db
# DATABASE_URL=

# --- App secrets (regenerate per environment!) ------------------------------
# openssl rand -base64 48
JWT_SECRET=__REPLACE_ME_AT_LEAST_32_RANDOM_BYTES__
JWT_EXPIRES_IN=1d
APP_KMS_KEY=__REPLACE_ME_AT_LEAST_32_RANDOM_BYTES__

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SUCCESS_URL=https://panel.verris.pl/dashboard/billing?status=success
STRIPE_CANCEL_URL=https://panel.verris.pl/dashboard/billing?status=cancel

# --- Observability (F-12 → F-16) -------------------------------------------
# Bearer token Prometheus uses to scrape /metrics. Leave empty to allow
# unauthenticated scrapes (only safe when Prometheus runs on the same private
# Docker network and Caddy doesn't expose /metrics publicly — recommended).
METRICS_AUTH_TOKEN=

# Grafana admin (used only for break-glass; everyday access goes through SSO).
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=__GENERATE_A_LONG_RANDOM_PASSWORD__

# Read-only Postgres password for Grafana data-source. Set this AFTER the
# first migrate-deploy (which creates the role with a placeholder password):
#   docker compose ... exec postgres psql -U verris -d verris_db \
#     -c "ALTER USER grafana_ro PASSWORD '<here>';"
GRAFANA_DB_RO_PASSWORD=__GENERATE_A_LONG_RANDOM_PASSWORD__

# --- Redis (shared: rate-limits / queues; `REDIS_URL` is read by the API for
# C-9 wallet auto-top-up worker and future BullMQ provisioning). Must match
# the `redis` Docker service hostname on the internal network.
REDIS_URL=redis://redis:6379

# --- Ticket uploads (E-4): absolute path inside the API container for attachment
# files. Persist with a Docker volume/bind mount mapped to this path; default in
# code is `./uploads/tickets` under `cwd` when unset (ephemeral unless you volume it).
# TICKET_UPLOAD_DIR=/data/ticket-uploads

# --- Security (E-8) — jeśli ustawione, burst failed logins wysyła też e-mail
SECURITY_ALERT_EMAIL=

# --- Mail (E-3) — skonfiguruj aby `MailerService` wysyłał prawdziwe maile
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Verris

# --- Compute node bootstrap (NOT read by docker-compose on control-plane) -----
# Export these on each **compute node** as root before running the admin-generated
# bootstrap script. Documented in DEPLOY.md → „Węzły obliczeniowe”.
# LITESPEED_SERIAL_NO=                       # LiteSpeed license serial; required if LSWS is not pre-installed
# LSWS_WEBADMIN_ALLOW_IP=203.0.113.5         # Optional; IP/CIDR allowed in LSWS WebAdmin <allow> (port 7080)
# PUBLIC_IP=                                 # Optional; defaults to auto-detect if unset
