# =============================================================================
# Verris panels — production image (Next.js)
# Multi-stage build for any of the three panels:
#   docker build -f Dockerfile.panel \
#     --build-arg APP_NAME=client-panel \
#     --build-arg APP_PORT=3001 \
#     -t verris/client-panel .
# Build context: monorepo root.
# =============================================================================

# PB-38 — Node 24 (Active LTS do 20.10.2026, potem Maintenance do 30.04.2028).
# Node 26 wchodzi, gdy zostanie LTS (koniec października 2026). Debian 13 „trixie” = obecny stable
# (bookworm od 06.2026 ma już tylko wsparcie LTS).
ARG NODE_VERSION=24
ARG APP_NAME=client-panel
ARG APP_PORT=3001

FROM node:${NODE_VERSION}-trixie-slim AS base
# Tajność projektu: bez telemetrii Next.js / Turborepo / Prismy przy buildzie i w działaniu.
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    NEXT_TELEMETRY_DISABLED=1 \
    TURBO_TELEMETRY_DISABLED=1 \
    DO_NOT_TRACK=1 \
    CHECKPOINT_DISABLE=1
# pnpm w wersji z packageManager (corepack znika z Node 25+, więc bez niego).
COPY package.json /tmp/pm.json
RUN npm install -g "$(node -p "require('/tmp/pm.json').packageManager")" && rm /tmp/pm.json
WORKDIR /workspace

# -----------------------------------------------------------------------------
# 1. Install
# -----------------------------------------------------------------------------
FROM base AS deps
ARG APP_NAME
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/${APP_NAME}/package.json apps/${APP_NAME}/package.json
COPY libs/contracts/package.json libs/contracts/package.json
COPY libs/ui/package.json libs/ui/package.json
COPY libs/typescript-config libs/typescript-config
COPY libs/eslint-config libs/eslint-config
RUN printf '\nnodeLinker: hoisted\n' >> pnpm-workspace.yaml
RUN --mount=type=cache,id=pnpm,target=/pnpm-store \
    pnpm install --store-dir /pnpm-store --frozen-lockfile --filter @verris/${APP_NAME}...

# -----------------------------------------------------------------------------
# 2. Build
# -----------------------------------------------------------------------------
FROM deps AS build
ARG APP_NAME
ARG API_URL
ARG CLIENT_PANEL_URL
ARG STAFF_PANEL_URL
ARG ADMIN_PANEL_URL
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_STAFF_PANEL_URL
ARG NEXT_PUBLIC_STATUS_PAGE_URL
ARG NEXT_PUBLIC_GRAFANA_URL
# CYBER-2 — anty-bot (build-time, wstrzykiwane do bundla Next):
ARG NEXT_PUBLIC_CAPTCHA_PROVIDER
ARG NEXT_PUBLIC_CAPTCHA_SITE_KEY
# Analityka/marketing (Consent Mode v2) — puste = wyłączone, baner pokazuje
# tylko kategorię funkcjonalną. Ustawiane przez repo Variables w deploy.yml.
ARG NEXT_PUBLIC_GTM_ID
ARG NEXT_PUBLIC_META_PIXEL_ID
ENV API_URL=${API_URL} \
    CLIENT_PANEL_URL=${CLIENT_PANEL_URL} \
    STAFF_PANEL_URL=${STAFF_PANEL_URL} \
    ADMIN_PANEL_URL=${ADMIN_PANEL_URL} \
    NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    NEXT_PUBLIC_STAFF_PANEL_URL=${NEXT_PUBLIC_STAFF_PANEL_URL} \
    NEXT_PUBLIC_STATUS_PAGE_URL=${NEXT_PUBLIC_STATUS_PAGE_URL} \
    NEXT_PUBLIC_GRAFANA_URL=${NEXT_PUBLIC_GRAFANA_URL} \
    NEXT_PUBLIC_CAPTCHA_PROVIDER=${NEXT_PUBLIC_CAPTCHA_PROVIDER} \
    NEXT_PUBLIC_CAPTCHA_SITE_KEY=${NEXT_PUBLIC_CAPTCHA_SITE_KEY} \
    NEXT_PUBLIC_GTM_ID=${NEXT_PUBLIC_GTM_ID} \
    NEXT_PUBLIC_META_PIXEL_ID=${NEXT_PUBLIC_META_PIXEL_ID}
COPY libs libs
COPY apps/${APP_NAME} apps/${APP_NAME}
RUN mkdir -p apps/${APP_NAME}/public

# X-27 — dowiązania pakietów odtwarzamy PO skopiowaniu źródeł.
#
# `COPY libs libs` kładzie katalogi pakietów na te, które zostawił etap `deps`,
# i pakiet traci WŁASNE node_modules. Dopóki każda zależność lądowała
# w node_modules katalogu głównego (linker `hoisted`), nie było tego widać —
# aż w drzewie stanęły dwie wersje jednego pakietu i ta zagnieżdżona zniknęła.
# Tu jeszcze nie wybuchło, ale to ten sam plik-bliźniak co Dockerfile.api
# i ta sama poprawka; naprawiona jedna kopia, a druga zostawiona, to wzorzec,
# który dał w tym projekcie Z-12, Z-16 i X-24.
RUN --mount=type=cache,id=pnpm,target=/pnpm-store \
    pnpm install --store-dir /pnpm-store --frozen-lockfile --prefer-offline --filter @verris/${APP_NAME}...

RUN pnpm --filter @verris/${APP_NAME} build

# -----------------------------------------------------------------------------
# 3. Runtime
# -----------------------------------------------------------------------------
FROM node:${NODE_VERSION}-trixie-slim AS runtime
ARG APP_NAME
ARG APP_PORT
# TZ — daty renderowane na serwerze (komponenty serwerowe) po polsku, jak w przeglądarce klienta.
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    DO_NOT_TRACK=1 \
    HOSTNAME=0.0.0.0 \
    APP_NAME=${APP_NAME} \
    PORT=${APP_PORT} \
    TZ=Europe/Warsaw
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl tini && \
    rm -rf /var/lib/apt/lists/*

# Next.js standalone output (panels with output: 'standalone' in next.config).
RUN mkdir -p ./apps/${APP_NAME}/public

COPY --from=build /workspace/apps/${APP_NAME}/.next/standalone ./
COPY --from=build /workspace/apps/${APP_NAME}/.next/static ./apps/${APP_NAME}/.next/static
COPY --from=build /workspace/apps/${APP_NAME}/public ./apps/${APP_NAME}/public

EXPOSE ${APP_PORT}

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -fsS http://127.0.0.1:${PORT}/api/health || exit 1

WORKDIR /app
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sh", "-c", "exec node apps/$APP_NAME/server.js"]
