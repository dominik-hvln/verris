{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "build:cli": "tsc -p tsconfig.cli.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "cli:rotate-kms": "pnpm build:cli && node dist-cli/cli/rotate-kms.js",
    "cli:storage-migrate-from-fs": "pnpm build:cli && node dist-cli/cli/storage-migrate-from-fs.js",
    "cli:seed-kb": "pnpm build:cli && node dist-cli/cli/seed-knowledge-base.js",
    "cli:seed-kb-cms": "pnpm build:cli && node dist-cli/cli/seed-kb-cms.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest --config jest.config.cjs",
    "test:int": "NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest --config jest.integration.cjs",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/schedule": "^12.0.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@simplewebauthn/server": "^14.0.2",
    "@verris/contracts": "workspace:^",
    "@verris/database": "workspace:*",
    "@verris/directadmin-sdk": "workspace:^",
    "archiver": "^8.0.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "minio": "^8.0.7",
    "multer": "^2.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.2",
    "ssh2": "^1.17.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.7",
    "@nestjs/schematics": "^12.0.5",
    "@rspack/core": "^2.2.7",
    "@types/archiver": "^8.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24",
    "@types/passport-jwt": "^4.0.1",
    "@verris/eslint-config": "workspace:*",
    "@verris/typescript-config": "workspace:*",
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.13",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.3",
    "webpack-node-externals": "^3.0.0"
  }
}
