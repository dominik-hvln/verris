# =============================================================================
# Verris API — environment variables
# Copy to .env and fill in proper secrets before running.
# =============================================================================

PORT=3000
NODE_ENV=development

# CORS / panels
CLIENT_PANEL_URL=http://localhost:3001
STAFF_PANEL_URL=http://localhost:3002
ADMIN_PANEL_URL=http://localhost:3003
STATUS_PAGE_URL=http://localhost:3004

# Public API URL — used in generated bootstrap scripts so nodes know where to
# call back to. Must be reachable from compute nodes.
PUBLIC_API_URL=http://localhost:3000
#
# Compute-node env vars for bootstrap (LITESPEED_SERIAL_NO, LSWS_WEBADMIN_ALLOW_IP)
# are documented in repo root DEPLOY.md — they are set on the server, not here.

# JWT — required in production, optional fallback in development
JWT_SECRET=change-me-please-use-a-real-32+-byte-secret
JWT_EXPIRES_IN=1d

# AES-256-GCM master key (>=32 chars). Used to encrypt DA passwords and other
# small secrets at rest. Generate with: openssl rand -base64 48
APP_KMS_KEY=change-me-please-use-a-real-32+-byte-key-aaaaaaaa

# Stripe (optional in dev — endpoints return 503 when missing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3001/dashboard/billing?status=success
STRIPE_CANCEL_URL=http://localhost:3001/dashboard/billing?status=cancel

# Database
DATABASE_URL=postgresql://verris:verris_password@localhost:5433/verris_db?schema=public

# Redis (opcjonalnie — BullMQ / auto-top-up; bez tego API działa, bez kolejki async)
# REDIS_URL=redis://localhost:6379

# Prometheus / Grafana. Set in production so /metrics is not anonymously readable.
METRICS_AUTH_TOKEN=

# Domain registrar provider. Leave empty until a real registrar adapter/API is contracted.
# When unset, registrar endpoints fail closed with 503 and do not simulate orders.
REGISTRAR_PROVIDER=
REGISTRAR_API_BASE_URL=
REGISTRAR_API_TOKEN=

# AI assistant. OpenAI-compatible chat completions endpoint; unset key = AI fails closed.
AI_PROVIDER=openai-compatible
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# =============================================================================
# Object storage — MinIO (S3-compatible)
# All file uploads (ticket attachments, RODO data exports, DPA PDFs, future
# invoices) live in MinIO buckets. Local FS is no longer used.
#
# In dev: `pnpm dev:up` brings up a MinIO container at http://127.0.0.1:9000
# (console: http://127.0.0.1:9001, login MINIO_ROOT_USER/MINIO_ROOT_PASSWORD).
# In prod: MinIO runs on the control-plane node via docker-compose.prod.yml,
# or you can repoint S3_ENDPOINT to a remote S3-compatible service (AWS S3,
# Backblaze B2, Cloudflare R2) without changing any code.
# =============================================================================
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=verris-dev
S3_SECRET_KEY=verris-dev-password
S3_REGION=eu-central-1
S3_USE_SSL=false
S3_PATH_STYLE=true
# Optional: override bucket names (default values shown below).
# S3_BUCKET_TICKET_ATTACHMENTS=verris-ticket-attachments
# S3_BUCKET_DATA_EXPORTS=verris-data-exports
# S3_BUCKET_DPA_PDFS=verris-dpa-pdfs
# S3_BUCKET_INVOICES=verris-invoices
# S3_BUCKET_BACKUPS=verris-backups

# MinIO root credentials (for the docker-compose `minio` and `minio-bootstrap`
# services). Should match S3_ACCESS_KEY / S3_SECRET_KEY in dev for simplicity;
# in prod create a dedicated user via `mc admin user add` instead of using root.
MINIO_ROOT_USER=verris-dev
MINIO_ROOT_PASSWORD=verris-dev-password

# Optional: scratch directory for staging data export ZIPs before they are
# uploaded to MinIO. Defaults to `os.tmpdir()/verris-data-exports`.
# DATA_EXPORT_TEMP_DIR=/var/tmp/verris-data-exports

# =============================================================================
# Mailing — Postfix on panel host (Sprint 2 emails)
# =============================================================================
# Default = panel-local Postfix (no AUTH, plaintext to localhost). For external
# relay (Resend/Postmark/SES) set SMTP_HOST/PORT/USER/PASS and SMTP_SECURE.
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_SECURE=none
# SMTP_USER=
# SMTP_PASS=
SMTP_FROM_ADDRESS=panel@verris.pl
SMTP_FROM_NAME=Verris

# =============================================================================
# Verris — billing / hosting brand details (used in invoices, emails, DPAs)
# =============================================================================
VERRIS_COMPANY_NAME=Verris Sp. z o.o.
VERRIS_COMPANY_ADDRESS=ul. Przykładowa 1, 00-001 Warszawa
VERRIS_COMPANY_NIP=0000000000
VERRIS_COMPANY_REGON=000000000
VERRIS_COMPANY_KRS=0000000000
VERRIS_COMPANY_BANK_ACCOUNT=PL00 0000 0000 0000 0000 0000 0000
VERRIS_COMPANY_BANK_NAME=mBank S.A.
VERRIS_COMPANY_EMAIL=kontakt@verris.pl
VERRIS_COMPANY_PHONE=+48 22 000 00 00
VERRIS_VAT_RATE=23

