# === Baza danych (Postgres) ===
# Payload używa własnego schematu `payload` na tej samej instancji Postgres,
# żeby nie kolidować z tabelami zarządzanymi przez Prisma (@verris/database).
DATABASE_URI=postgres://verris:verris@localhost:5432/verris

# === Payload ===
