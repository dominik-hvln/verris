{
  "name": "@verris/www",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack -p 3005",
    "build": "payload generate:importmap && next build",
    "start": "next start -p 3005",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "payload": "cross-env PAYLOAD_CONFIG_PATH=payload.config.ts payload",
    "generate:types": "cross-env PAYLOAD_CONFIG_PATH=payload.config.ts payload generate:types"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.90.1",
    "@payloadcms/next": "^3.90.1",
    "@payloadcms/richtext-lexical": "^3.90.1",
    "@payloadcms/storage-s3": "^3.90.1",
    "@payloadcms/ui": "^3.90.1",
    "graphql": "^16.14.2",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "payload": "^3.90.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@verris/typescript-config": "workspace:*",
    "cross-env": "^10.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "typescript": "^5"
  }
}
