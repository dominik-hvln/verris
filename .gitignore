.turbo/
*.tsbuildinfo

# Env & secrets (keep .env.example committed)
.env
.env.local
.env.*.local
# UWAGA: .env.prod NIE pasuje do zadnego z powyzszych wzorcow. Na produkcji
# lezal jako plik niesledzony, ale NIEIGNOROWANY — razem z trzema kopiami
# zapasowymi. Jedno `git add -A` w /opt/verris wrzucaloby haslo do Postgresa,
# JWT_SECRET, APP_KMS_KEY i klucze Stripe do repozytorium na GitHubie.
.env.prod
.env.prod.bak*

# Znacznik ostatniego dobrego tagu obrazu — stan hosta, nie zrodlo.
.last-good-image-tag

# IDE
.idea/
.vscode/*
!.vscode/extensions.json

# OS
.DS_Store
Thumbs.db

