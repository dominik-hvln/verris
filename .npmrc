# Pin pnpm's content-addressable store inside the workspace so installs work
# in restricted environments (CI sandboxes, Cursor sandbox, locked-down dev VMs)
# where ~/Library/pnpm/store / ~/.local/share/pnpm/store is not writable.
#
# Both `store-dir` and `cache-dir` are intentionally inside the workspace.
# `prefer-offline=true` makes pnpm reuse what we already have in node_modules
# instead of re-fetching every package on minor lockfile changes.
store-dir=node_modules/.pnpm-store
cache-dir=node_modules/.pnpm-cache
prefer-offline=true
auto-install-peers=true
strict-peer-dependencies=false
# Don't ask for "are you sure?" before removing/recreating node_modules.
# Required for non-TTY environments (sandboxes, CI, agentic tools).
confirm-modules-purge=false

# ENV-01 — silnik deklarowany i silnik faktyczny muszą być tym samym silnikiem.
#
# Do 2026-08-28 bramka lokalna biegła na Node 20, a CI na 22; pnpm wypisywał
# ostrzeżenie przy każdym uruchomieniu i nikt go nie czytał. Po decyzji nr 1
# z 2026-08-28 jedyną realną bramką przed `main` jest bramka uruchamiana
# lokalnie — więc „zielone u mnie" na innym silniku niż produkcyjny jest
# słabszym dowodem, niż wygląda, i to dokładnie w miejscu, na którym
# oparliśmy cały proces.
#
# engine-strict zamienia to ostrzeżenie w odmowę. Świadomie NIE włączono go
# 2026-08-28, bo zablokowałoby `pnpm install` właścicielowi repozytorium bez
# jego zgody; zgoda jest z 2026-09-19.
#
# Jeżeli `pnpm install` odmawia: `nvm use` (czyta .nvmrc = 22). To nie jest
# usterka konfiguracji, tylko ta konfiguracja działająca.
engine-strict=true
